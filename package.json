{
  "name": "next-token-tv-website",
  "private": true,
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run generate:og",
    "dev": "astro dev --host 127.0.0.1 --port 4174",
    "import:episode": "node scripts/import-episode.mjs",
    "import:transcript": "node scripts/import-transcript.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "build": "npm run generate:og && npm run check:chapters && npm run test:transcript && npm run test:community && astro check && astro build",
    "build:assets": "npm run generate:og && astro build",
    "performance:audit": "node scripts/performance.mjs audit",
    "performance:report": "node scripts/performance.mjs report",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 4174",
    "check": "npm run check:chapters && npm run test:transcript && npm run test:community && npm run test:article && npm run test:release && npm run lint:styles && npm run check:worker && astro check && npm run check:redirects && npm run test:maintenance && npm run check:artwork",
    "test:article": "node --experimental-strip-types --test tests/article-markdown.test.mjs tests/blog-content.test.mjs tests/blog-rss.test.mjs",
    "test:release": "node --test tests/announcement-schedule.test.mjs tests/episode-release.test.mjs tests/platform-release.test.mjs tests/https-redirect.test.mjs tests/og-retention.test.mjs tests/browser-test-runner.test.mjs",
    "test:transcript": "node --experimental-strip-types --test tests/transcript-converter.test.mjs tests/transcript-paragraph-anchors.test.mjs tests/transcript-timing.test.mjs",
    "lint:styles": "stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "test:visual": "node scripts/run-browser-tests.mjs visual",
    "test:performance": "node scripts/run-browser-tests.mjs performance",
    "test:visual:update": "node scripts/run-browser-tests.mjs visual --update-snapshots",
    "check:artwork": "node scripts/check-episode-artwork.mjs",
    "check:release": "node scripts/check-release.mjs && npm run check:seo && npm run check:artwork -- --dist",
    "check:links": "node scripts/check-release.mjs",
    "release:check": "node scripts/release-check.mjs",
    "deploy": "node scripts/release.mjs deploy",
    "import:chapters": "node scripts/import-chapters.mjs",
    "check:chapters": "node scripts/check-chapters.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:worker": "wrangler types && tsc -p worker/tsconfig.json",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:resume": "node scripts/release.mjs resume",
    "release:publish": "node scripts/release.mjs publish",
    "release:rollback": "node scripts/release.mjs rollback",
    "library:report": "node scripts/library-report.mjs",
    "entity:migrate": "node --experimental-strip-types scripts/entity-migrate.mjs",
    "generate:redirects": "node scripts/generate-entity-redirects.mjs",
    "check:redirects": "node scripts/generate-entity-redirects.mjs --check",
    "test:maintenance": "node --experimental-strip-types --test tests/maintenance.test.mjs tests/search.test.mjs tests/catalog-relations.test.mjs tests/performance-workflow.test.mjs tests/release-checkpoint.test.mjs tests/episode-artwork.test.mjs",
    "community:qr": "node scripts/generate-community-qr.mjs",
    "test:community": "node --test tests/community-qr.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "^3.7.4",
    "@playwright/test": "^1.63.0",
    "astro": "^7.3.1",
    "htmlparser2": "9.1.0",
    "js-yaml": "^5.4.1",
    "jsqr": "^1.4.0",
    "postcss-html": "^2.0.0",
    "qrcode": "^1.5.4",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "wrangler": "^4.101.0"
  }
}
