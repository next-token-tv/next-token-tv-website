{
  "name": "next-token-tv-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4174",
    "import:episode": "node scripts/import-episode.mjs",
    "import:transcript": "node scripts/import-transcript.mjs",
    "build": "npm run check:chapters && npm run test:transcript && astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4174",
    "check": "npm run check:chapters && npm run test:transcript && npm run lint:styles && astro check",
    "test:transcript": "node --test tests/transcript-converter.test.mjs",
    "lint:styles": "stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "check:release": "node scripts/check-release.mjs",
    "release:check": "npm run check && npm run test:visual && npm run check:release",
    "deploy": "npm run release:check && wrangler deploy",
    "import:chapters": "node scripts/import-chapters.mjs",
    "check:chapters": "node scripts/check-chapters.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "^3.7.4",
    "@playwright/test": "^1.63.0",
    "astro": "^7.3.1",
    "js-yaml": "^5.4.1",
    "postcss-html": "^2.0.0",
    "remark-parse": "^11.0.0",
    "stylelint": "^17.15.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "wrangler": "^4.101.0"
  }
}
