{
  "name": "next-token-tv-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4174",
    "import:episode": "node scripts/import-episode.mjs",
    "build": "npm run check:chapters && astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4174",
    "check": "npm run check:chapters && astro check",
    "deploy": "npm run build && wrangler deploy",
    "import:chapters": "node scripts/import-chapters.mjs",
    "check:chapters": "node scripts/check-chapters.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.101.0"
  }
}
