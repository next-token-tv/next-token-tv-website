---
import { platforms } from "../data/platforms.mjs";
interface Props {
  platform: string;
  name: string;
}
const { platform, name } = Astro.props;
const icon = platforms[platform as keyof typeof platforms]?.icon;
---
<span class="platform-brand">
  {icon && <img class="platform-logo" src={icon} width="28" height="28" alt="" aria-hidden="true" />}
  <span>{name}</span>
</span>
<style>
  .platform-brand { display: inline-flex; align-items: center; gap: .65rem; min-width: 0; }
  .platform-logo { display: block; flex: 0 0 1.75rem; width: 1.75rem; height: 1.75rem; object-fit: contain; }
</style>
