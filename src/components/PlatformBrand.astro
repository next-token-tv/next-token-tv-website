---
import { platformAssets, platformIcon } from "../data/platforms.mjs";
interface Props {
  platform: string;
  name: string;
}
const { platform, name } = Astro.props;
const icon = platformIcon(platform);
const size = platformAssets[platform as keyof typeof platformAssets]?.size ?? 1.75;
---
<span class="platform-brand">
  {icon && <span class="platform-logo-slot" aria-hidden="true"><img class="platform-logo" src={icon} width="28" height="28" alt="" style={`--platform-mark-size: ${size}rem`} /></span>}
  <span>{name}</span>
</span>
<style>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
.platform-brand { display: inline-flex; align-items: center; gap: .65rem; min-width: 0; }
  .platform-logo-slot { display: flex; align-items: center; justify-content: center; flex: 0 0 1.75rem; width: 1.75rem; height: 1.75rem; }
  .platform-logo { display: block; flex: none; width: var(--platform-mark-size); height: var(--platform-mark-size); max-width: none; object-fit: contain; }
}
</style>
