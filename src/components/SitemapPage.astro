---
import { getTerms } from "../data/terms";
import { getBlogPosts } from "../data/blog";
import { getBrandDirectory, getProductDirectory, getEpisodesForShow, getPublishedTranscriptEpisodes } from "../data/catalog";
import { getPartners } from "../data/partners";
import type { Locale } from "../data/types";
import { getCollection } from "astro:content";
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === "en";
const people = await getCollection("people");
const prefix = en ? "/en" : "";
const [brands, products, episodes, transcripts, partners] = await Promise.all([
  getBrandDirectory(locale), getProductDirectory(locale),
  getEpisodesForShow("next-token-weekly"), getPublishedTranscriptEpisodes(locale), getPartners(),
]);
const blogPosts = await getBlogPosts(locale);
const terms = await getTerms(locale);
const groups = [
  { id: "explore", title: en ? "Explore" : "主要入口", links: [
    { label: en ? "Home" : "首页", href: prefix || "/" },
    { label: en ? "About Next Token" : "关于品牌", href: `${prefix || "/"}#about` },
    { label: en ? "Blog" : "博客", href: `${prefix}/blog` },
    { label: "Next Token Weekly", href: `${prefix}/weekly` },
    { label: en ? "Co-hosts" : "联合主理人", href: `${prefix || "/"}#hosts` },
    { label: en ? "Venue partners" : "合作伙伴", href: `${prefix}/partners` },
    { label: en ? "Community & Subscriptions" : "社群与订阅", href: `${prefix}/community` },
    { label: en ? "Wiki" : "AI 资料库", href: `${prefix}/wiki` },
    { label: en ? "Brands" : "品牌库", href: `${prefix}/wiki/brands` },
    { label: en ? "Terms" : "术语", href: `${prefix}/wiki/terms` },
    { label: en ? "Products" : "产品库", href: `${prefix}/wiki/products` },
    { label: en ? "People" : "人物库", href: `${prefix}/wiki/people` },
    { label: en ? "Data API" : "资料库 API", href: `${prefix}/api` },
    { label: en ? "Brand Kit" : "品牌素材", href: `${prefix}/brand-kit` },
    { label: en ? "Design system" : "设计系统", href: `${prefix}/design-system` },
  ] },
  { id: "episodes", title: en ? "Episodes & previews" : "节目与预告", links: episodes.slice().sort((a,b) => Number(b.data.number)-Number(a.data.number)).map(e => ({ label: e.data.title[locale], href: `${prefix}/weekly/${e.data.number}` })) },
  { id: "transcripts", title: en ? "Transcripts" : "文字稿", links: transcripts.map(e => ({ label: `Weekly #${e.data.number} · ${en ? "Transcript" : "完整文字稿"}`, href: `${prefix}/weekly/${e.data.number}/transcript` })) },
  { id: "blog", title: en ? "Blog" : "博客", links: blogPosts.map(post => ({ label: post.data.title, href: `${prefix}/blog/${post.id}` })) },
  { id: "people", title: en ? "People" : "人物资料", links: people.map(p => ({ label: p.data.name[locale], href: `${prefix}/wiki/people/${p.id}` })) },
  { id: "partners", title: en ? "Partner profiles" : "合作伙伴资料", links: partners.map(p => ({ label: en ? p.englishName : p.name, href: `${prefix}/partners/${p.slug}` })) },
  { id: "brands", title: en ? "Brands" : "品牌", links: brands.map(({brand}) => ({ label: brand.data.name[locale], href: `${prefix}/wiki/brands/${brand.id}` })) },
  { id: "products", title: en ? "Products" : "产品", links: products.map(({product}) => ({ label: product.data.name[locale], href: `${prefix}/wiki/products/${product.id}` })) },
  { id: "terms", title: en ? "Terms" : "术语", links: terms.map(term => ({ label: term.data.name[locale], href: `${prefix}/wiki/terms/${term.id}` })) },
].filter(group => group.links.length);
const episodeRows = episodes.slice().sort((a, b) => Number(b.data.number) - Number(a.data.number));
const transcriptNumbers = new Set(transcripts.map(e => e.data.number));
const episodeGroup = groups.find(group => group.id === "episodes")!;
const transcriptGroup = groups.find(group => group.id === "transcripts");
const episodeDisplayTitle = (episode: (typeof episodeRows)[number]) => episode.data.status === "published"
  ? episode.data.homepage[locale].heading.join(en ? " " : "")
  : episode.data.preview.heading[locale].join(en ? " " : "");
---
<main id="main" class="sitemap-page shell">
  <header class="sitemap-intro">
    <p class="section-kicker">NEXT TOKEN / {en ? "EXPLORE" : "全站导航"}</p>
    <h1 class="type-title">{en ? "Sitemap" : "网站地图"}</h1>
    <p>{en ? "Find episodes, transcripts, people and the brands behind our conversations." : "从这里找到节目、文字稿、主理人，以及对谈中提到的品牌与产品。"}</p>
    <nav aria-label={en ? "Sitemap sections" : "网站地图分类"}>
      {groups.map(group => <a href={`#${group.id}`}>{group.title}</a>)}
    </nav>
  </header>
  {groups.filter(group => group.id !== "transcripts").map(group => group.id === "episodes" ? (
    <div class:list={["sitemap-episodes", { "has-transcripts": !!transcriptGroup }]} style={`--episode-rows: ${episodeRows.length + 1}`}>
      {[episodeGroup, ...(transcriptGroup ? [transcriptGroup] : [])].map(column => (
        <section id={column.id} aria-labelledby={`${column.id}-title`}>
          <div class="sitemap-section-heading">
            <h2 id={`${column.id}-title`} class="heading-section-compact">{column.title}</h2>
            <span>{column.links.length}</span>
          </div>
          <ul>
            {episodeRows.map((episode, index) => {
              const isTranscript = column.id === "transcripts";
              const available = !isTranscript || transcriptNumbers.has(episode.data.number);
              return <li class:list={{ "empty-episode": !available }} style={`grid-row: ${index + 2}`} aria-hidden={!available ? "true" : undefined}>
                {available && <a href={`${prefix}/weekly/${episode.data.number}${isTranscript ? "/transcript" : ""}`}>
                  <span class="episode-label">
                    <small>Weekly #{episode.data.number}</small>
                    <span class="episode-title">{isTranscript ? (en ? "Full transcript" : "完整文字稿") : episodeDisplayTitle(episode)}</span>
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>}
              </li>;
            })}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <section id={group.id} aria-labelledby={`${group.id}-title`}>
      <div class="sitemap-section-heading">
        <h2 id={`${group.id}-title`} class="heading-section-compact">{group.title}</h2>
        <span>{group.links.length}</span>
      </div>
      <ul>
        {group.links.map(link => <li><a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a></li>)}
      </ul>
    </section>
  ))}
</main>
<style>
@import "../styles/components/sitemap-page.css";
</style>
