---
import { siteLinks, type Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const perspective = locale === "zh-Hans"
  ? "来自中文世界的 AI 现场观点。"
  : "Perspectives on AI from the Chinese-speaking world.";
const en = locale === "en";
const prefix = en ? "/en" : "";
const groups = [
  { title: en ? "Explore" : "内容", links: [
    { label: en ? "Episodes" : "节目", href: `${prefix}/weekly` },
    { label: en ? "Blog" : "博客", href: `${prefix}/blog` },
    { label: en ? "Wiki" : "资料库", href: `${prefix}/wiki` },
  ] },
  { title: en ? "About" : "关于", links: [
    { label: en ? "About Next Token" : "关于品牌", href: `${prefix || "/"}#about` },
    { label: en ? "Co-hosts" : "联合主理人", href: `${prefix || "/"}#hosts` },
    { label: en ? "Partners" : "合作伙伴", href: `${prefix}/partners` },
    { label: en ? "Brand Kit" : "品牌素材", href: `${prefix}/brand-kit` },
  ] },
  { title: en ? "Stay connected" : "保持联系", links: [
    { label: en ? "Join the community" : "加入社群", href: `${prefix}/community#join` },
    { label: en ? "Follow the show" : "订阅节目", href: `${prefix}/weekly#subscribe` },
  ] },
  { title: en ? "Open access" : "开放访问", links: [
    { label: en ? "Data API (中文)" : "Data API", href: "/api" },
    { label: en ? "Episode RSS (中文)" : "节目 RSS", href: "/weekly/rss.xml", type: "application/rss+xml" },
    { label: en ? "Blog RSS" : "博客 RSS", href: `${prefix}/blog/rss.xml`, type: "application/rss+xml" },
    { label: "llms.txt", href: "/llms.txt", type: "text/plain" },
    { label: en ? "Sitemap" : "网站地图", href: `${prefix}/sitemap` },
    { label: "GitHub", href: siteLinks.github, external: true },
  ] },
];
---

<footer class="site-footer">
  <div class="footer-brand">
    <div class="footer-main shell">
      <h2>Beyond the<br />Next Token.</h2>
      <span class="footer-mark" aria-hidden="true"></span>
    </div>
  </div>
  <div class="footer-directory shell">
    <p class="footer-perspective">{perspective}</p>
    {groups.map((group, index) => <nav aria-labelledby={`footer-group-${index}`}>
      <h3 id={`footer-group-${index}`}>{group.title}</h3>
      <ul>{group.links.map(link => <li><a class="footer-link" href={link.href} type={"type" in link ? link.type : undefined} target={"external" in link ? "_blank" : undefined} rel={"external" in link ? "noopener noreferrer" : undefined}>{link.label}</a></li>)}</ul>
    </nav>)}
  </div>
  <div class="footer-bottom shell">
    <span>© {new Date().getFullYear()} NEXT TOKEN · NEXTTOKEN.TV</span>

  </div>
</footer>
