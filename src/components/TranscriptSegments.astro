---
import type { CollectionEntry } from "astro:content";

type Segment = CollectionEntry<"transcriptImports">["data"]["chapters"][number]["turns"][number]["paragraphs"][number][number];

interface Props {
  segments: Segment[];
  /** Locale prefix for entity links, e.g. "/en"; entity hrefs are authored against the Chinese wiki. */
  wikiPrefix?: string;
}

const { segments, wikiPrefix = "" } = Astro.props;
---

{segments.map((segment) => {
  const content = segment.marks?.includes("strong")
    ? <strong>{segment.value}</strong>
    : segment.marks?.includes("emphasis")
      ? <em>{segment.value}</em>
      : segment.value;

  if (segment.type === "entity-link") {
    const href = wikiPrefix && segment.href && /^\/wiki\//.test(segment.href) ? `${wikiPrefix}${segment.href}` : segment.href;
    return <a class="transcript-entity-link" data-entity-type={segment.entityType} href={href}>{content}</a>;
  }
  if (segment.type === "external-link") {
    return <a href={segment.href} target="_blank" rel="noopener noreferrer">{content}</a>;
  }
  if (segment.type === "code") return <code>{segment.value}</code>;
  return content;
})}
