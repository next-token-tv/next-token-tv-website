---
import { getBrandDirectory, getProductDirectory, getPeopleDirectory } from "../data/catalog";
import type { Locale } from "../data/types";
import { displayAliases } from "../data/entity-aliases";

interface Props {
  entityType: "brands" | "products" | "people";
  locale: Locale;
}

const { entityType, locale } = Astro.props;
const prefix = locale === "en" ? "/en" : "";
const brandKind = {
  "ai-brand": { "zh-Hans": "人工智能", en: "Artificial intelligence" },
  "hardware-brand": { "zh-Hans": "硬件与半导体", en: "Hardware & semiconductors" },
  "internet-software-brand": { "zh-Hans": "互联网与软件服务", en: "Internet & software services" },
  "media-community-brand": { "zh-Hans": "媒体与社区", en: "Media & communities" },
  "other-brand": { "zh-Hans": "其他", en: "Other" },
} as const;
const productKind = {
  "model-family": { "zh-Hans": "模型家族", en: "Model family" },
  model: { "zh-Hans": "模型", en: "Model" },
  show: { "zh-Hans": "节目", en: "Show" },
  game: { "zh-Hans": "游戏", en: "Game" },
  book: { "zh-Hans": "图书", en: "Book" },
  "operating-system": { "zh-Hans": "操作系统", en: "Operating system" },
  application: { "zh-Hans": "应用", en: "Application" },
  agent: { "zh-Hans": "Agent", en: "Agent" },
  tool: { "zh-Hans": "工具", en: "Tool" },
  "developer-tool": { "zh-Hans": "开发者工具", en: "Developer tool" },
  platform: { "zh-Hans": "平台", en: "Platform" },
  "api-service": { "zh-Hans": "API 服务", en: "API service" },
  hardware: { "zh-Hans": "硬件", en: "Hardware" },
  framework: { "zh-Hans": "框架", en: "Framework" },
} as const;

const peopleKind = {
  "co-host": { "zh-Hans": "联合主理人", en: "Co-hosts" },
  "mentioned": { "zh-Hans": "节目提及", en: "Mentioned people" },
} as const;
const entries = entityType === "people"
  ? (await getPeopleDirectory(locale)).map(({ person, isHost, episodesCount }) => ({
      id: person.id, name: person.data.name[locale],
      kindId: isHost ? "co-host" : "mentioned",
      kind: peopleKind[isHost ? "co-host" : "mentioned"][locale],
      summary: person.data.bio[locale], aliases: person.data.aliases,
      relation: locale === "en" ? `${episodesCount} related episode${episodesCount === 1 ? "" : "s"}` : `${episodesCount} 期相关节目`,
    }))
  : entityType === "brands"
  ? (await getBrandDirectory(locale)).map(({ brand, productsCount, episodesCount }) => ({
      id: brand.id,
      name: brand.data.name[locale],
      kindId: brand.data.kind,
      kind: brandKind[brand.data.kind][locale],
      summary: brand.data.summary[locale],
      aliases: brand.data.aliases,
      relation: locale === "en"
        ? `${productsCount} product${productsCount === 1 ? "" : "s"} · ${episodesCount} episode${episodesCount === 1 ? "" : "s"}`
        : `${productsCount} 个产品 · ${episodesCount} 期节目`,
    }))
  : (await getProductDirectory(locale)).map(({ product, brand, episodesCount }) => ({
      id: product.id,
      name: product.data.name[locale],
      kindId: product.data.kind,
      kind: productKind[product.data.kind][locale],
      summary: product.data.summary[locale],
      aliases: displayAliases(product.data.name, product.data.aliases),
      relation: locale === "en"
        ? `${brand ? `${brand.data.name.en} · ` : ""}${episodesCount} episode${episodesCount === 1 ? "" : "s"}`
        : `${brand ? `${brand.data.name["zh-Hans"]} · ` : ""}${episodesCount} 期节目`,
    }));

const copy = entityType === "people" ? (locale === "en" ? {
  eyebrow: "Next Token / Wiki", title: "People",
  lede: "The co-hosts, builders and researchers in our conversations.",
  count: `${entries.length} people`, brands: "Brands", products: "Products", aliases: "Also known as",
  open: "Person profile", filterLabel: "People", all: "All",
} : {
  eyebrow: "Next Token / AI 资料库", title: "人物库",
  lede: "认识节目中的主理人，以及对谈中提到的创业者、开发者与研究者。",
  count: `${entries.length} 位人物`, brands: "品牌", products: "产品", aliases: "别名",
  open: "人物详情", filterLabel: "人物分类", all: "全部",
}) : locale === "en"
  ? {
      eyebrow: "Next Token / Wiki",
      title: entityType === "brands" ? "Brands" : "Products",
      lede: entityType === "brands"
        ? "The companies, organizations and media brands that appear in Next Token conversations."
        : "Models, agents, applications, and tools referenced across Next Token episodes.",
      count: `${entries.length} ${entityType}`,
      brands: "Brands",
      products: "Products",
      aliases: "Also known as",
      open: entityType === "brands" ? "Brand profile" : "Product profile",
      filterLabel: entityType === "brands" ? "Brand type" : "Product type",
      all: "All",
    }
  : {
      eyebrow: "Next Token / AI 资料库",
      title: entityType === "brands" ? "品牌库" : "产品库",
      lede: entityType === "brands"
        ? "整理 Next Token 对话中出现的公司、组织与媒体品牌。"
        : "整理节目中提到的模型、Agent、应用与开发工具。",
      count: `${entries.length} 个${entityType === "brands" ? "品牌" : "产品"}`,
      brands: "品牌",
      products: "产品",
      aliases: "别名",
      open: entityType === "brands" ? "品牌详情" : "产品详情",
      filterLabel: entityType === "brands" ? "品牌类型" : "产品类型",
      all: "全部",
    };

const filterOptions = entityType === "people"
  ? (Object.keys(peopleKind) as Array<keyof typeof peopleKind>)
      .map(id => ({ id, label: peopleKind[id][locale], count: entries.filter(entry => entry.kindId === id).length }))
      .filter(({ count }) => count > 0)
  : entityType === "brands"
  ? (Object.keys(brandKind) as Array<keyof typeof brandKind>)
      .map((id) => ({ id, label: brandKind[id][locale], count: entries.filter((entry) => entry.kindId === id).length }))
      .filter(({ count }) => count > 0)
  : (Object.keys(productKind) as Array<keyof typeof productKind>)
      .map((id) => ({ id, label: productKind[id][locale], count: entries.filter((entry) => entry.kindId === id).length }))
      .filter(({ count }) => count > 0);
---

<main id="main" class="entity-index-page">
  <section class="entity-index-hero shell" aria-labelledby="entity-index-title">
    <p class="eyebrow"><a href={`${prefix}/wiki`}>{copy.eyebrow} ↗</a></p>
    <div>
      <h1 class="entity-index-title" id="entity-index-title">{copy.title}</h1>
      <div class="entity-index-intro">
        <p class="entity-index-lede">{copy.lede}</p>
        <strong class="entity-index-count">{copy.count}</strong>
      </div>
    </div>
  </section>

  <nav class="entity-library-switch shell" aria-label={locale === "en" ? "Wiki" : "AI 资料库"}>
    <a href={`${prefix}/wiki/brands`} aria-current={entityType === "brands" ? "page" : undefined}>{copy.brands}</a>
    <a href={`${prefix}/wiki/products`} aria-current={entityType === "products" ? "page" : undefined}>{copy.products}</a>
    <a href={`${prefix}/wiki/people`} aria-current={entityType === "people" ? "page" : undefined}>{locale === "en" ? "People" : "人物"}</a>
  </nav>

  <div class="entity-secondary-filters shell" data-entity-filters>
    <p>{copy.filterLabel}</p>
    <div role="group" aria-label={copy.filterLabel}>
      <button type="button" data-entity-filter="all" aria-pressed="true" aria-controls="entity-directory-list">
        <span>{copy.all}</span><strong>{entries.length}</strong>
      </button>
      {filterOptions.map((option) => (
        <button type="button" data-entity-filter={option.id} aria-pressed="false" aria-controls="entity-directory-list">
          <span>{option.label}</span><strong>{option.count}</strong>
        </button>
      ))}
    </div>
  </div>

  <section id="entity-directory-list" class="entity-directory shell" aria-label={copy.title} aria-live="polite">
    {entries.map((entry, index) => (
      <a class="entity-directory-row" href={`${prefix}/wiki/${entityType}/${entry.id}`} data-entity-kind={entry.kindId}>
        <span class="entity-directory-index">{String(index + 1).padStart(2, "0")}</span>
        <div class="entity-directory-identity">
          <span>{entry.kind}</span>
          <h2 class="entity-directory-name">{entry.name}</h2>
          {entry.aliases.length > 0 && <p class="entity-directory-aliases"><span class="entity-directory-aliases-label">{copy.aliases}</span>{entry.aliases.join(" · ")}</p>}
        </div>
        <p class="entity-directory-summary">{entry.summary}</p>
        <span class="entity-directory-relation">{entry.relation}</span>
        <span class="entity-directory-open"><span>{copy.open}</span><b aria-hidden="true">→</b></span>
      </a>
    ))}
  </section>
</main>

<script>
  const filterRoot = document.querySelector<HTMLElement>("[data-entity-filters]");
  const rows = [...document.querySelectorAll<HTMLElement>("[data-entity-kind]")];
  const buttons = filterRoot ? [...filterRoot.querySelectorAll<HTMLButtonElement>("[data-entity-filter]")] : [];
  const validFilters = new Set(buttons.map((button) => button.dataset.entityFilter));

  function setFilter(requestedFilter: string | null, updateUrl = false) {
    const filter = requestedFilter && validFilters.has(requestedFilter) ? requestedFilter : "all";
    buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.entityFilter === filter)));
    rows.forEach((row) => { row.hidden = filter !== "all" && row.dataset.entityKind !== filter; });
    const visibleRows = rows.filter((row) => !row.hidden);
    rows.forEach((row) => row.classList.toggle("is-last-visible", row === visibleRows.at(-1)));

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (filter === "all") url.searchParams.delete("type");
      else url.searchParams.set("type", filter);
      window.history.pushState({}, "", `${url.pathname}${url.search}${url.hash}`);
    }
  }

  buttons.forEach((button) => button.addEventListener("click", () => setFilter(button.dataset.entityFilter ?? "all", true)));
  window.addEventListener("popstate", () => setFilter(new URLSearchParams(window.location.search).get("type")));
  setFilter(new URLSearchParams(window.location.search).get("type"));
</script>

<style>
  .entity-index-hero { padding-block: 2.5rem 2.25rem; border-bottom: 1px solid var(--ink); }
  .entity-index-hero > .eyebrow { margin: 0 0 1.5rem; }
  .entity-index-hero > .eyebrow a:hover { color: var(--signal); }
  .entity-index-hero > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .8fr); gap: 2rem; align-items: end; }
  .entity-index-title { margin: 0; font-size: 3.5rem; line-height: 1.13; }
  .entity-index-intro { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; padding-bottom: .25rem; }
  .entity-index-lede { max-width: 28rem; margin: 0; color: var(--muted); font-size: .95rem; line-height: 1.6; }
  .entity-index-count { flex: 0 0 auto; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .entity-library-switch { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding-block: 1rem; }
  .entity-library-switch a { min-width: 0; padding: .65rem .5rem; border: 0.0625rem solid var(--ink); font-family: var(--display); font-size: 1.2rem; text-align: center; white-space: nowrap; }
  .entity-library-switch a + a { border-left: 0; }
  .entity-library-switch a[aria-current="page"] { color: var(--paper); background: var(--ink); }
  .entity-secondary-filters { display: grid; grid-template-columns: minmax(7rem, .16fr) minmax(0, 1fr); gap: 1rem; align-items: start; padding-block: .5rem 1.25rem; }
  .entity-secondary-filters > p { margin: .85rem 0 0; color: var(--muted); font-size: .875rem; font-weight: 750; }
  .entity-secondary-filters > div { display: flex; flex-wrap: wrap; gap: .65rem; }
  .entity-secondary-filters button { display: inline-flex; min-height: 2.5rem; align-items: center; gap: 1.5rem; padding: .45rem .7rem; border: 1px solid var(--line); color: var(--ink); background: transparent; font: inherit; font-size: .875rem; font-weight: 750; cursor: pointer; }
  .entity-secondary-filters button strong { color: var(--muted); font-size: .75rem; }
  .entity-secondary-filters button:hover { color: var(--paper); background: var(--ink); }
  .entity-secondary-filters button:hover strong { color: rgba(255,255,255,.65); }
  .entity-secondary-filters button[aria-pressed="true"] { color: var(--ink); border-color: var(--signal); background: var(--signal); }
  .entity-secondary-filters button[aria-pressed="true"] strong { color: var(--ink); }
  .entity-directory { padding-bottom: clamp(5rem, 10vw, 10rem); }
  .entity-directory-row { display: grid; grid-template-columns: 3.5rem minmax(13rem, .9fr) minmax(17rem, 1.25fr) minmax(10rem, .5fr) 3.5rem; min-height: 8.5rem; border: 1px solid var(--ink); border-bottom: 0; transition: color 180ms ease, background 180ms ease; }
  .entity-directory-row[hidden] { display: none; }
  .entity-directory-row:last-child,
  .entity-directory-row.is-last-visible { border-bottom: 1px solid var(--ink); }
  .entity-directory-row:hover { background: var(--white); }
  .entity-directory-row > * { padding: 1rem 1.15rem; }
  .entity-directory-row > * + * { border-left: 1px solid var(--ink); }
  .entity-directory-index { font-weight: 800; }
  .entity-directory-identity > span { display: block; margin-bottom: .4rem; font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .entity-directory-name { margin: 0; font-size: 1.65rem; line-height: var(--section-heading-leading); }
  .entity-directory-aliases { overflow: hidden; margin: .4rem 0 0; color: var(--muted); font-size: .82rem; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
  .entity-directory-aliases-label { display: inline; margin-right: .4rem; font-size: .68rem; font-weight: 800; text-transform: uppercase; }
  .entity-directory-summary { align-self: center; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.55; }
  .entity-directory-relation { display: flex; align-items: center; font-size: .78rem; font-weight: 700; }
  .entity-directory-open { display: flex; flex-direction: column; justify-content: center; background: var(--ink); color: var(--paper); }
  .entity-directory-open > span { display: none; }
  .entity-directory-open b { margin: auto; align-self: end; font-size: 1.6rem; }
  .entity-directory-row:hover .entity-directory-open { color: var(--ink); background: var(--signal); }
  @media (max-width: 70rem) {
    .entity-directory-row { grid-template-columns: 3.5rem minmax(12rem, .85fr) minmax(0, 1.25fr) 3.5rem; }
    .entity-directory-relation { display: none; }
  }
  @media (max-width: 45rem) {
    .entity-index-hero { padding-block: 2rem; }
    .entity-index-hero > div { grid-template-columns: 1fr; gap: .8rem; }
    .entity-index-title { font-size: 2.7rem; }
    .entity-index-intro { align-items: start; }
    .entity-index-lede { max-width: 24rem; }
    .entity-secondary-filters { grid-template-columns: 1fr; gap: .9rem; padding-bottom: 1.5rem; }
    .entity-secondary-filters > p { margin: 0; }
    .entity-secondary-filters > div { flex-wrap: nowrap; overflow-x: auto; padding-bottom: .35rem; scrollbar-width: thin; }
    .entity-secondary-filters button { flex: 0 0 auto; }
    .entity-directory-row { grid-template-columns: 2.5rem minmax(0, 1fr) 3rem; min-height: 0; }
    .entity-directory-row > * { padding: .8rem; }
    .entity-directory-identity { grid-column: 2; }
    .entity-directory-row > .entity-directory-summary { grid-column: 1 / -1; display: block; border-top: .0625rem solid var(--line); border-left: 0; }
    .entity-directory-open { grid-column: 3; grid-row: 1; }
  }
</style>
