---
import type { Locale } from "../data/types";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteContent } from "../data/site";
import { createWikiApi } from "../data/wiki-api";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const prefix = locale === "en" ? "/en" : "";
const copy = (zh: string, en: string) => locale === "en" ? en : zh;
const content = await getSiteContent(locale);
const collections = await createWikiApi(Astro.site!);
const endpoints = [
  { label: copy("术语", "Terms"), id: "terms", count: collections.terms.length },
  { label: copy("品牌", "Brands"), id: "brands", count: collections.brands.length },
  { label: copy("产品", "Products"), id: "products", count: collections.products.length },
  { label: copy("人物", "People"), id: "people", count: collections.people.length },
];
---

<BaseLayout
  content={content}
  pageTitle={copy("资料库 API｜Next Token", "Data API | Next Token")}
  description={copy("通过公开、只读、版本化的 JSON API 获取 Next Token 资料库中的品牌、产品、人物、术语及其关系。", "Access brands, products, people, terms, and their relationships from the Next Token wiki through a public, read-only, versioned JSON API.")}
  canonicalPath={`${prefix}/api`}
  alternatePath={locale === "en" ? "/api" : "/en/api"}
>
  <main id="main" class="api-docs shell">
    <header class="api-hero">
      <div>
        <p class="section-kicker">NEXT TOKEN / DATA API</p>
        <h1 class="type-title">{copy("获取资料库", "Structured data")}<br /><span>{copy("结构化数据。", "from the wiki.")}</span></h1>
      </div>
      <div class="api-intro">
        <p>{copy("公开、只读、无须鉴权。获取品牌、产品、人物、术语及其关联信息，支持列表查询与单条详情。", "Public, read-only, no authentication. Retrieve brands, products, people, terms, and their relationships, with list queries and per-entity details.")}</p>
        <a class="button button-dark" href="/api/v1/wiki.json">{copy("打开 API 入口", "Open the API entry point")} <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="api-section" aria-labelledby="collections-title">
      <div class="api-section-heading">
        <p class="section-kicker">01 / COLLECTIONS</p>
        <h2 id="collections-title" class="heading-section-compact">{copy("四个集合，统一契约。", "Four collections, one contract.")}</h2>
      </div>
      <div class="api-collections">
        {endpoints.map((endpoint, index) => (
          <a href={`/api/v1/wiki/${endpoint.id}.json`}>
            <span>{String(index + 1).padStart(2, "0")} / {endpoint.count}</span>
            <strong>{endpoint.label}</strong>
            <code>/api/v1/wiki/{endpoint.id}.json</code>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="api-section api-contract" aria-labelledby="contract-title">
      <div class="api-section-heading">
        <p class="section-kicker">02 / CONTRACT</p>
        <h2 id="contract-title" class="heading-section-compact">{copy("列表，也有单实体详情。", "Lists, plus per-entity details.")}</h2>
      </div>
      <div class="api-contract-grid">
        <div>
          <h3>{copy("集合响应", "Collection response")}</h3>
          <code>{`{
  "schemaVersion": 1,
  "collection": "brands",
  "count": ${collections.brands.length},
  "data": [...]
}`}</code>
        </div>
        <div>
          <h3>{copy("公共实体字段", "Shared entity fields")}</h3>
          <p><code>id</code>{copy(" 是稳定引用键；", " is the stable reference key; ")}<code>url</code>{copy(" 指向资料页；", " points to the wiki page; ")}<code>apiUrl</code>{copy(" 指向单实体 JSON。记录同时提供双语名称与简介、类别、别名、来源、核验日期；品牌、产品和人物还提供 ", " points to the per-entity JSON. Records carry bilingual names and summaries, kinds, aliases, sources, verification dates, ; brand, product and person records also provide ")}<code>relationships</code>{copy("。", ".")}</p>
        </div>
        <div>
          <h3>{copy("单实体路径", "Per-entity paths")}</h3>
          <code>/api/v1/wiki/brands/&lt;id&gt;.json</code>
          <code>/api/v1/wiki/products/&lt;id&gt;.json</code>
          <code>/api/v1/wiki/people/&lt;id&gt;.json</code>
          <code>/api/v1/wiki/terms/&lt;id&gt;.json</code>
        </div>
        <div>
          <h3>{copy("筛选与跨域", "Filtering and CORS")}</h3>
          <p>{copy("品牌与产品可按 ", "Brands and products can be filtered client-side by ")}<code>kind</code>{copy(" 在客户端筛选。所有响应使用 UTF-8 JSON，并允许浏览器跨域读取。", ". All responses are UTF-8 JSON and readable cross-origin from browsers.")}</p>
        </div>
      </div>
    </section>


  </main>
</BaseLayout>

<style>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
.api-docs { padding-bottom: 7rem; }
  .api-hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); gap: 4rem; align-items: start; padding-block: 3rem 4rem; border-bottom: var(--stroke-thin) solid var(--line-strong); }
  .api-hero h1 { margin: 1rem 0 0; }
  .api-hero h1 span { color: var(--signal-text); }
  .api-intro { max-width: 31rem; }
  .api-intro p { margin: 0 0 1.5rem; color: var(--muted); line-height: 1.8; }
  .api-section { padding-block: 4rem; border-bottom: var(--stroke-thin) solid var(--line-strong); }
  .api-section-heading { display: grid; grid-template-columns: minmax(11rem, 0.45fr) minmax(0, 1.55fr); gap: 3rem; margin-bottom: 2rem; }
  .api-section-heading h2 { margin: 0; }
  .api-collections { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: var(--stroke-thin) solid var(--line); border-left: var(--stroke-thin) solid var(--line); }
  .api-collections a { position: relative; display: flex; min-width: 0; min-height: 14rem; flex-direction: column; gap: 1.25rem; padding: 1.5rem; border-right: var(--stroke-thin) solid var(--line); border-bottom: var(--stroke-thin) solid var(--line); }
  .api-collections a > span:first-child { color: var(--signal-text); font-size: var(--type-caption); font-weight: 800; }
  .api-collections a > span:last-child { position: absolute; top: 1.5rem; right: 1.5rem; color: var(--signal-text); }
  .api-collections strong { margin-top: auto; font-family: var(--display); font-size: 2rem; }
  code { font-family: var(--mono); }
  .api-collections code { overflow-wrap: anywhere; color: var(--muted); font-size: var(--type-meta); }
  .api-contract-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: var(--stroke-thin) solid var(--line); border-left: var(--stroke-thin) solid var(--line); }
  .api-contract-grid > div { min-width: 0; padding: 2rem; border-right: var(--stroke-thin) solid var(--line); border-bottom: var(--stroke-thin) solid var(--line); }
  .api-contract-grid h3 { margin: 0 0 1.25rem; font-size: var(--type-base); }
  .api-contract-grid p { max-width: 40rem; margin: 0; color: var(--muted); line-height: 1.8; }
  .api-contract-grid > div > code { display: block; overflow-x: auto; white-space: pre; font-size: var(--type-meta); line-height: 1.7; }
  @media (max-width: 60rem) {
    .api-hero { grid-template-columns: 1fr; min-height: 0; gap: 2.5rem; }
    .api-section-heading { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 40rem) {
    .api-docs { padding-bottom: 4rem; }
    .api-hero { padding-block: 3rem; }
    .api-section { padding-block: 3rem; }
    .api-collections, .api-contract-grid { grid-template-columns: 1fr; }
    .api-collections a { min-height: 10rem; }
  }
}
</style>
