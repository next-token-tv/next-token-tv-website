---
import { getEpisodeMentionEntities } from "../data/catalog";
import { getEpisodeTerms } from "../data/terms";
import { brandKind, productKind, personKind } from "../data/entity-kind-labels";
import type { Locale } from "../data/types";

interface Props { episodeId: string; locale: Locale; }
const { episodeId, locale } = Astro.props;
const [mentions, terms] = await Promise.all([
  getEpisodeMentionEntities(episodeId),
  getEpisodeTerms(episodeId, locale),
]);
const prefix = locale === "en" ? "/en" : "";
const copy = locale === "en"
  ? { kicker: "Referenced in this episode", title: terms.length ? "People, brands, products and terms" : "People, brands and products", brand: "Brands", product: "Products", terms: "Terms" }
  : { kicker: "本期提及", title: terms.length ? "人物、品牌、产品与术语" : "人物、品牌与产品", brand: "品牌", product: "产品", terms: "术语" };
type MentionItem = { name: string; href: string; kind: string };
function subgroups(items: MentionItem[], labels: Record<string, Record<Locale, string>>) {
  return Object.entries(labels).map(([kind, label]) => ({
    kind, label: label[locale], items: items.filter(item => item.kind === kind),
  })).filter(group => group.items.length > 0);
}
const groups = [
  {
    kind: "person",
    label: locale === "en" ? "People" : "人物",
    labels: personKind,
    items: mentions.people.map(person => ({ kind: person.data.kind, name: person.data.name[locale], href: `${prefix}/wiki/people/${person.id}` })),
  },
  {
    kind: "brand",
    label: copy.brand,
    labels: brandKind,
    items: mentions.brands.map((brand) => ({ kind: brand.data.kind, name: brand.data.name[locale], href: `${prefix}/wiki/brands/${brand.id}` })),
  },
  {
    kind: "product",
    label: copy.product,
    labels: productKind,
    items: mentions.products.map((product) => ({ kind: product.data.kind, name: product.data.name[locale], href: `${prefix}/wiki/products/${product.id}` })),
  },
].filter((group) => group.items.length > 0);
---

{(groups.length > 0 || terms.length > 0) && (
  <section class="episode-mentions shell" aria-labelledby="episode-mentions-title">
    <div>
      <p class="section-kicker">02 / {copy.kicker}</p>
      <h2 class="heading-section-content" id="episode-mentions-title">{copy.title}</h2>
    </div>
    <div class="episode-mention-groups">
      {groups.map((group) => (
        <div class="episode-mention-group" data-mention-kind={group.kind}>
          <div class="episode-mention-group-heading">
            <h3>{group.label}</h3>
            <span>{group.items.length}</span>
          </div>
          <div class="episode-mention-subgroups">
            {subgroups(group.items, group.labels).map(subgroup => (
              <div class="episode-mention-subgroup" data-mention-subkind={subgroup.kind}>
                <h4>{subgroup.label}</h4>
                <div class="episode-mention-list">
                  {subgroup.items.map(item => <a href={item.href}><strong>{item.name}</strong><b aria-hidden="true">→</b></a>)}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
      {terms.length > 0 && (
        <div class="episode-mention-group" data-mention-kind="term" id="episode-terms">
          <div class="episode-mention-group-heading">
            <h3>{copy.terms}</h3>
            <span>{terms.length}</span>
          </div>
          <div class="episode-mention-subgroup episode-mention-subgroup-unlabelled">
            <div class="episode-mention-list">
              {terms.map(term => (
                <a href={`${prefix}/wiki/terms/${term.id}`}><strong>{term.data.name[locale]}</strong><b aria-hidden="true">→</b></a>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
@import "../styles/components/episode-mentions.css";
</style>
