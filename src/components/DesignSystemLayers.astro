---
import type { Locale } from '../data/types';
import ColorUse from './DesignSystemColorUse.astro';
interface Props { locale: Locale }
const {locale}=Astro.props;
const t=(zh:string,en:string)=>locale==='en'?en:zh;
---
<div class="ds-layers" id="overlay-colors">
 <h3>{t('叠层与投影','Layers and shadows')}</h3>
 <p>{t('透明度在所在背景上叠加。投影仅用于菜单与浮层，普通内容通过留白和分隔线组织。','Opacity is composited over the underlying background. Shadows belong to menus and popovers; space and rules organize ordinary content.')}</p>
 <div class="ds-layer-grid">
  <article><div class="ds-layer-demo"><span class="ds-menu-demo">{t('菜单','Menu')}</span></div><h4>{t('菜单投影','Menu shadow')}</h4><p><ColorUse locale={locale} token="--shadow-soft-color" /></p><code>0 0.75rem 1.5rem</code></article>
  <article><div class="ds-layer-demo"><span class="ds-popover-demo">{t('浮层','Popover')}</span></div><h4>{t('浮层投影','Popover shadow')}</h4><p><ColorUse locale={locale} token="--shadow-floating-color" /></p><code>0 0.5rem 1.5rem</code></article>
 </div>
 <p>{t('固定导航底色：','Sticky navigation: ')}<ColorUse locale={locale} token="--header-surface" />{t('。图片上的文字衬底：透明渐变至','; text scrims on images: a gradient from transparent to ')} <ColorUse locale={locale} token="--image-scrim" />{t('。','.')}</p>
</div>
<style>
@import "../styles/components/design-system-layers.css";
</style>
