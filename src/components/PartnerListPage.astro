---
import PartnerRow from "./PartnerRow.astro";
import { getCollection, render } from "astro:content";
import type { Locale } from "../data/site";
import { getPartners } from "../data/partners";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const partners = await getPartners();
const invitations = await getCollection("prose", ({ data }) =>
  data.entityType === "brand" && data.entity === "next-token"
  && data.locale === locale && data.slot === "partner-invitation");
if (invitations.length !== 1) throw new Error(`Expected one ${locale} partner invitation`);
const { Content: Invitation } = await render(invitations[0]!);
const copy = locale === "zh-Hans"
  ? {
      eyebrow: "Next Token / 合作网络",
      title: ["场地", "合作伙伴"],
      lede: "这些空间为现场对话提供了真实的发生地，也让技术、产品与人的连接延伸到节目之外。",
      count: `${partners.length} 个伙伴`,
      columnLabel: "伙伴目录",
    }
  : {
      eyebrow: "Next Token / Partner network",
      title: ["Venue partners"],
      lede: "These spaces give our conversations a physical home—and carry the connection between technology, products, and people beyond the program.",
      count: `${partners.length} partner${partners.length === 1 ? "" : "s"}`,
      columnLabel: "Partner directory",
    };
---

<main id="main" class="partners-page">
  <section class="partners-intro shell" aria-labelledby="partners-title">
    <p class="eyebrow">{copy.eyebrow}</p>
    <div class="partners-intro-grid">
      <h1 class="type-title" id="partners-title">{copy.title.map(line => <span class:list={{ "partners-title-line": locale === "zh-Hans" }}>{line}</span>)}</h1>
      <div class="partners-intro-copy">
        <p>{copy.lede}</p>
        <span>{copy.count}</span>
      </div>
    </div>
  </section>

  <section class="partner-directory shell" aria-label={copy.columnLabel}>
    {partners.map((partner) => <PartnerRow partner={partner} locale={locale} />)}
  </section>

  <section class="partner-invitation shell" aria-labelledby="partner-invitation-title">
    <div>
      <p class="eyebrow">{locale === "zh-Hans" ? "Next Token / 合作邀请" : "Next Token / Partner with us"}</p>
      <h2 id="partner-invitation-title">{locale === "zh-Hans" ? "下一场对话，" : "Make room for"}<br />{locale === "zh-Hans" ? "在你的空间发生。" : "the next conversation."}</h2>
    </div>
    <div class="partner-invitation-copy">
      <Invitation />
      <a class="partner-contact" href={`${locale === "en" ? "/en" : "/"}#hosts`}>
        {locale === "zh-Hans" ? "通过主理人联系合作" : "Contact our co-hosts"} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</main>

<style>
@import "../styles/components/partner-list-page.css";
</style>
