---
interface Props { label: string; title: string; square?: boolean; photo?: string; name?: string; class?: string }
const { label, title, square = false, photo, name, class: className } = Astro.props;
---
<div class:list={["wiki-identity-card", className, { square, "has-photo": !!photo }]}>
  {photo ? <img src={photo} alt={name ?? title} width="192" height="192" /> : <>
    <div class="masthead"><span>{label}</span><i aria-hidden="true"></i></div>
    <strong>{title}</strong>
    <div class="caption"><span>Next Token / Wiki</span><span class="rule" aria-hidden="true"></span></div>
  </>}
</div>
<style>
@import "../styles/components/wiki-identity-card.css";
</style>
