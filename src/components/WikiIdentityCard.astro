---
interface Props { label: string; title: string; square?: boolean; photo?: string; name?: string; class?: string }
const { label, title, square = false, photo, name, class: className } = Astro.props;
---
<div class:list={["wiki-identity-card", className, { square, "has-photo": !!photo }]}>
  {photo ? <img src={photo} alt={name ?? title} width="192" height="192" /> : <>
    <div class="masthead"><span>{label}</span><i aria-hidden="true"></i></div>
    <strong>{title}</strong>
    <div class="caption"><span>Next Token / Wiki</span><span class="rule" aria-hidden="true"></span></div>
  </>}
</div>
<style>
  .wiki-identity-card { container-type: inline-size; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; height: var(--wiki-visual-height); padding: 1.25rem 1.5rem; background: var(--ink); color: var(--paper); }
  .square { width: var(--wiki-visual-height); }
  .masthead { display: flex; justify-content: space-between; align-items: center; gap: .75rem; font-size: 1rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .masthead i { flex: 0 0 .5rem; height: .5rem; background: var(--signal); }
  strong { font-family: var(--display); font-size: clamp(1.35rem, 14cqi, 2.75rem); line-height: 1.15; letter-spacing: var(--display-tracking); }
  .square strong { text-align: center; font-size: 2rem; overflow-wrap: anywhere; }
  .caption { display: flex; align-items: center; gap: 1rem; font-size: .65rem; color: rgba(255,255,255,.5); }
  .caption > span:first-child { white-space: nowrap; }
  .rule { height: 1px; flex: 1; background: rgba(255,255,255,.25); }
  .has-photo { padding: 0; }
  img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 760px) {
    .wiki-identity-card { padding: 1rem 1.25rem; }
    strong { font-size: 2rem; }
    .square { padding-inline: 1rem; }
    .has-photo { padding: 0; }
  }
</style>
