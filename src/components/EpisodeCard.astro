---
import { getDetailEpisode } from "../data/catalog";
import TranscriptLink from "./TranscriptLink.astro";
import type { Locale } from "../data/types";
import { episodeImageSrcset } from "../data/episode-images";
interface Props { episodeId: string; locale: Locale }
const { episodeId, locale } = Astro.props;
const episode = await getDetailEpisode(episodeId);
const copy = episode.data.homepage[locale];
const images = episode.data.images;
const dimensions = episode.data.imageDimensions;
const mediaLabel = locale === "en"
  ? (episode.data.media.video ? (episode.data.media.audio ? "Audio & video" : "Video") : "Audio")
  : (episode.data.media.video ? (episode.data.media.audio ? "音频 / 视频" : "视频") : "音频");
const releaseLabel = (episode.data.media.audio || episode.data.media.video) ? `${episode.data.releaseDate} · ${mediaLabel}` : "";
const href = `${locale === "en" ? "/en" : ""}/weekly/${episode.data.number}`;
---
<article class:list={["weekly-card", { "has-artwork": episode.data.imageKind === "artwork" }]} data-episode-number={episode.data.number}>
  <a class:list={["weekly-image", { "is-artwork": episode.data.imageKind === "artwork" }]} href={href} aria-label={[episode.data.title[locale], releaseLabel].filter(Boolean).join(" · ")}>
    <img
      src={images["960"]}
      srcset={episodeImageSrcset(images)}
      sizes="(max-width: 31.25rem) calc(100vw - 2.5rem), (max-width: 62.5rem) 92vw, (min-width: 100rem) 43.2rem, (min-width: 88rem) calc(47.52rem - 4.32vw), 49.68vw"
      width={dimensions.width}
      height={dimensions.height}
      loading="lazy"
      decoding="async"
      alt={copy.imageAlt}
    />
  </a>
  <div class="weekly-copy">
    <div class="episode-number">#{episode.data.number}</div>
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h3>{copy.heading.join(locale === "en" ? " " : "")}</h3>
      {releaseLabel && <p class="episode-release">{releaseLabel}</p>}
      <p>{copy.copy}</p>
      <div class="episode-meta" aria-label={copy.topicsLabel}>{copy.topics.map(topic => <span>{topic}</span>)}</div>
      <div class="episode-actions">
        <a class="episode-listen" href={href}>{locale === "en" ? (!episode.data.media.audio && !episode.data.media.video ? "Explore episode" : episode.data.media.video ? "Listen / watch" : "Listen now") : (!episode.data.media.audio && !episode.data.media.video ? "查看本期" : episode.data.media.video ? "收听 / 收看" : "立即收听")} ↗</a>
        <TranscriptLink episodeId={episodeId} number={episode.data.number} locale={locale} />
      </div>
    </div>
  </div>
</article>
<style>
@import "../styles/components/episode-card.css";
</style>
