---
import "../styles/wiki-detail.css";
import WikiDetailHeader from "./WikiDetailHeader.astro";
import WikiIdentityCard from "./WikiIdentityCard.astro";
import WikiArticle from "./WikiArticle.astro";
import { displayAliases } from "../data/entity-aliases";
import type { Locale } from "../data/types";
import type { CollectionEntry } from "astro:content";

interface Props { term: CollectionEntry<"terms">; locale: Locale }
const { term, locale } = Astro.props;
const en = locale === "en";
const prefix = en ? "/en" : "";
const aliases = displayAliases(term.data.name, term.data.aliases);
// The card carries the name in the other language, mirroring how entity cards show the category.
const cardTitle = en ? term.data.name["zh-Hans"] : term.data.name.en;
const definedTerm = {
  "@context": "https://schema.org", "@type": "DefinedTerm",
  name: term.data.name[locale], description: term.data.summary[locale], alternateName: aliases,
  url: new URL(`${prefix}/wiki/terms/${term.id}`, Astro.site).href,
  inDefinedTermSet: new URL(`${prefix}/wiki/terms`, Astro.site).href,
};
---
<main id="main" class="term-detail has-wiki-article">
  <WikiDetailHeader backHref={`${prefix}/wiki/terms`} backLabel={en ? "All terms" : "全部术语"}
    name={term.data.name[locale]} summary={term.data.summary[locale]} aliases={aliases} aliasesLabel={en ? "Also known as" : "别名"}>
    <WikiIdentityCard label={en ? "Term" : "术语"} title={cardTitle} />
  </WikiDetailHeader>
  <WikiArticle entityType="term" entityId={term.id} name={term.data.name[locale]} locale={locale} lastVerifiedAt={term.data.lastVerifiedAt} />
  <section class="wiki-support-section shell" aria-labelledby="term-sources">
    <h2 class="wiki-support-heading" id="term-sources">{en ? "Sources" : "参考资料"}</h2>
    <div><ul class="term-source-list">{term.data.sources.map(source => <li class="wiki-support-item"><a class="wiki-support-link" href={source.href} target="_blank" rel="noopener noreferrer">{source.label[locale]} ↗</a></li>)}</ul></div>
  </section>
</main>
<script is:inline type="application/ld+json" set:html={JSON.stringify(definedTerm).replace(/</g, "\\u003c")} />
<style>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
  main.term-detail { padding-bottom: 2.5rem; }
  .term-source-list { list-style: none; margin: 0; padding: 0; }
  .term-source-list li { padding-block: .5rem; }
}
</style>
