---
import { announcementCopy } from "../data/announcement-copy.mjs";
import { getAnnouncedEpisodes } from "../data/catalog";
import { resolveVenueId } from "../data/partners";
import type { Locale } from "../data/types";

interface Props { locale: Locale; showId?: string }
const { locale, showId = "next-token-weekly" } = Astro.props;
const episodes = await getAnnouncedEpisodes();
const episode = episodes.filter(({ data }) => data.show === showId)
  .sort((a, b) => a.data.status === "announced" && b.data.status === "announced"
    ? Date.parse(a.data.scheduledAt) - Date.parse(b.data.scheduledAt) : 0)[0];
const data = episode?.data.status === "announced" ? episode.data : undefined;
const statusCopy = data ? announcementCopy(data, locale) : undefined;
const recording = data?.recordingVenue ? await resolveVenueId(data.recordingVenue) : undefined;
const date = data ? new Intl.DateTimeFormat(locale === "en" ? "en-US" : "zh-Hans", {
  month: "short", day: "numeric", ...(data.scheduledAt.length > 10 ? { hour: "numeric" as const, minute: "2-digit" as const } : {}),
  hour12: locale === "en", timeZone: data.timeZone,
}).format(new Date(data.scheduledAt)) : "";
const venue = data?.recordingMode === "online" ? (locale === "en" ? "Online recording" : "线上录制") : recording ? `${locale === "en" ? recording.partner.englishName : recording.partner.name} · ${recording.venue.name[locale]}` : data?.recordingLocation?.[locale] ?? "";
---

{data && (
  <a class="upcoming-episode-link" href={`${locale === "en" ? "/en" : ""}/weekly/${data.number}`}>
    <span class="upcoming-episode-label">{statusCopy?.label} · Weekly #{data.number}</span>
    <span class="upcoming-episode-meta">{date} · {venue}</span>
    <span class="upcoming-episode-action">{locale === "en" ? "View preview" : "查看预告"} <span aria-hidden="true">→</span></span>
  </a>
)}

<style>
@import "../styles/components/upcoming-episode-link.css";
</style>
