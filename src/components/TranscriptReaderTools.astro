---
import type { Locale } from "../data/types";
interface Props { locale: Locale; persistPreference?: boolean }
const { locale, persistPreference = true } = Astro.props;
const en = locale === "en";
---
<div class="transcript-search" hidden data-reader-tools data-language={locale} data-reader-persist={String(persistPreference)}>
  <label for="transcript-search">{en ? "Search transcript" : "搜索文字稿"}</label>
  <div class="transcript-search-input">
    <input id="transcript-search" type="search" placeholder={en ? "Name, product or keyword" : "人物、产品或关键词"} autocomplete="off" />
    <button type="button" data-clear hidden>{en ? "Clear" : "清除"}</button>
  </div>
  <div class="transcript-entity-controls">
    <div class="transcript-entity-legend" aria-label={en ? "Entity legend" : "实体图例"}>
      <span class="transcript-entity-key" data-entity-type="brand">{en ? "Brand" : "品牌"}</span>
      <span class="transcript-entity-key" data-entity-type="product">{en ? "Product" : "产品"}</span>
      <span class="transcript-entity-key" data-entity-type="person">{en ? "Person" : "人物"}</span>
    </div>
    <button class="control-switch" type="button" role="switch" aria-checked="false" data-entity-highlight-toggle>
      <span>{en ? "Highlight" : "高亮"}</span>
      <span class="control-switch-track" aria-hidden="true"></span>
    </button>
  </div>
  <p role="status" aria-live="polite" data-search-status></p>
  <ol data-search-results></ol>
</div>
<script>
  const tools = document.querySelector<HTMLElement>('[data-reader-tools]');
  if (tools) {
    tools.hidden = false;
    const highlight = tools.querySelector<HTMLButtonElement>('[data-entity-highlight-toggle]')!;
    const transcriptPage = tools.closest<HTMLElement>('.transcript-page')!;
    const persistPreference = tools.dataset.readerPersist !== 'false';
    const highlightStorageKey = 'next-token-transcript-entity-highlight';
    const setHighlight = (enabled: boolean) => {
      highlight.setAttribute('aria-checked', String(enabled));
      transcriptPage.dataset.entityHighlight = String(enabled);
    };
    try {
      setHighlight(persistPreference && window.localStorage.getItem(highlightStorageKey) === 'true');
    } catch {
      setHighlight(false);
    }
    highlight.addEventListener('click', () => {
      const enabled = highlight.getAttribute('aria-checked') !== 'true';
      setHighlight(enabled);
      try {
        if (persistPreference) window.localStorage.setItem(highlightStorageKey, String(enabled));
      } catch {
        // The visual setting still applies for this page when storage is unavailable.
      }
    });
    const en = tools.dataset.language === 'en';
    const input = tools.querySelector<HTMLInputElement>('input')!;
    const clear = tools.querySelector<HTMLButtonElement>('[data-clear]')!;
    const status = tools.querySelector<HTMLElement>('[data-search-status]')!;
    const results = tools.querySelector<HTMLOListElement>('[data-search-results]')!;
    const chapters = [...transcriptPage.querySelectorAll<HTMLElement>('.transcript-chapter')];
    const entries = chapters.flatMap((chapter) => {
      const heading = chapter.querySelector('h2, h3')!;
      const title = heading.textContent ?? '';
      const turns = [...chapter.querySelectorAll<HTMLElement>('.transcript-turn')];
      return [{ id: chapter.id, title, text: title }, ...turns.map((turn, i) => {
        turn.id = `${chapter.id}-turn-${i + 1}`;
        return { id: turn.id, title, text: (() => { const copy = turn.cloneNode(true) as HTMLElement; copy.querySelectorAll('[data-paragraph-copy], .transcript-paragraph-feedback, .transcript-paragraph-time').forEach(node => node.remove()); return copy.textContent?.replace(/\s+/g, ' ').trim() ?? ''; })() };
      })];
    });
    const search = () => {
      clear.hidden = input.value.length === 0;
      const query = input.value.trim().toLocaleLowerCase();
      results.replaceChildren();
      if (!query) { status.textContent = ''; return; }
      const matches = entries.filter(({ text }) => text.toLocaleLowerCase().includes(query));
      status.textContent = en ? `${matches.length} results${matches.length > 50 ? ' · showing first 50' : ''}` : `${matches.length} 处匹配${matches.length > 50 ? ' · 显示前 50 处' : ''}`;
      for (const match of matches.slice(0, 50)) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${match.id}`;
        const at = match.text.toLocaleLowerCase().indexOf(query);
        const from = Math.max(0, at - 24);
        const snippet = match.text.slice(from, at + query.length + 50);
        const text = `${match.title} — ${from ? '…' : ''}${snippet}`;
        const folded = text.toLocaleLowerCase();
        let cursor = 0;
        let found = folded.indexOf(query);
        while (found !== -1) {
          link.append(document.createTextNode(text.slice(cursor, found)));
          const mark = document.createElement('mark');
          mark.textContent = text.slice(found, found + query.length);
          link.append(mark);
          cursor = found + query.length;
          found = folded.indexOf(query, cursor);
        }
        link.append(document.createTextNode(text.slice(cursor)));
        li.append(link); results.append(li);
      }
    };
    input.addEventListener('input', search);
    clear.addEventListener('click', () => { input.value = ''; search(); input.focus(); });
    search();
    for (const chapter of chapters) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'transcript-copy-link';
      button.textContent = en ? 'Copy chapter link' : '复制章节链接';
      const feedback = document.createElement('span');
      feedback.setAttribute('role', 'status');
      button.addEventListener('click', async () => {
        const url = new URL(document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? location.href);
        url.hash = chapter.id;
        try {
          await navigator.clipboard.writeText(url.href);
          document.dispatchEvent(new CustomEvent('nexttoken:copy', { detail: { kind: 'chapter', anchor: chapter.id } }));
          feedback.textContent = en ? ' Copied' : ' 已复制';
        } catch {
          feedback.textContent = en ? ' Copy this link: ' : ' 请复制此链接：';
          const fallback = document.createElement('input');
          fallback.value = url.href; fallback.readOnly = true;
          fallback.setAttribute('aria-label', en ? 'Chapter link' : '章节链接');
          feedback.append(fallback); fallback.select();
        }
      });
      const row = document.createElement('div');
      row.className = 'transcript-share'; row.append(button, feedback);
      chapter.querySelector('header')!.append(row);
    }
    for (const link of transcriptPage.querySelectorAll<HTMLAnchorElement>('[data-paragraph-copy]')) {
      link.addEventListener('click', async (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        const url = new URL(document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? link.href);
        url.hash = new URL(link.href).hash;
        location.hash = url.hash;
        let feedback = link.nextElementSibling;
        if (!feedback?.matches('.transcript-paragraph-feedback')) {
          feedback = document.createElement('span');
          feedback.className = 'transcript-paragraph-feedback';
          feedback.setAttribute('role', 'status');
          link.after(feedback);
        }
        try {
          await navigator.clipboard.writeText(url.href);
          document.dispatchEvent(new CustomEvent('nexttoken:copy', { detail: { kind: 'paragraph', anchor: url.hash.slice(1) } }));
          feedback.textContent = en ? ' Copied' : ' 已复制';
        } catch {
          feedback.textContent = en ? ' Copy this link: ' : ' 请复制此链接：';
          const fallback = document.createElement('input');
          fallback.value = url.href;
          fallback.readOnly = true;
          fallback.setAttribute('aria-label', en ? 'Paragraph link' : '段落链接');
          feedback.append(fallback);
          fallback.select();
        }
      });
    }
    if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
  }
</script>
<style is:global>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
@media (min-width: 62.5625rem) {
    .transcript-sidebar { max-height: calc(100svh - 8rem); overflow-y: auto; }
  }
  .transcript-search { margin-bottom: 1rem; font-size: var(--type-ui); }
  .transcript-search label { display: block; margin-bottom: 0.5rem; font-weight: 700; }
  .transcript-search-input { border-radius: var(--control-radius); display: flex; align-items: center; border: var(--stroke-thin) solid var(--line-control); }
  .transcript-search-input:focus-within { border-color: var(--signal-text); outline: var(--stroke-emphasis) solid var(--signal-text); outline-offset: 3px; }
  .transcript-search input { min-width: 0; width: 100%; min-height: var(--control-height); padding: 0.625rem; border: 0; border-radius: 0; background: transparent; font: inherit; appearance: none; }
  .transcript-search input:focus-visible { outline: none; }
  .transcript-search input::-webkit-search-cancel-button { appearance: none; }
  .transcript-search-input button { min-width: var(--control-height); min-height: var(--control-height); margin-inline-end: 0.5rem; flex-shrink: 0; }
  .transcript-search-input button:focus-visible { outline: var(--stroke-emphasis) solid var(--signal-text); outline-offset: 0; }
  .transcript-search button:not(.control-switch), .transcript-copy-link { padding: 0.25rem; border: 0; background: transparent; color: var(--ink); font: inherit; cursor: pointer; white-space: nowrap; }
  .transcript-entity-controls { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.875rem; font-size: var(--type-caption); }
  .transcript-entity-legend { display: flex; align-items: center; gap: 0.75rem; }
  .transcript-search [role="status"] { margin: 0.5rem 0; color: var(--muted); }
  .transcript-search ol { max-height: 16rem; overflow: auto; padding: 0; list-style: none; }
  .transcript-search li { margin-bottom: 0.75rem; }
  .transcript-search mark { background: var(--highlight-match); color: var(--ink); font-weight: 750; }
  .transcript-search a:hover, .transcript-copy-link:hover { text-decoration: underline; }
  .transcript-share { grid-column: 2; font-size: var(--type-meta); color: var(--muted); }
  .transcript-share input { max-width: 100%; font: inherit; }
  .transcript-turn { scroll-margin-top: 7rem; }
  .transcript-turn:target { outline: var(--stroke-thin) solid var(--signal); outline-offset: 0.5rem; }
  .transcript-quote-paragraph { scroll-margin-top: 7rem; }
  .transcript-quote-paragraph:target { background: var(--highlight-target); outline: var(--stroke-emphasis) solid var(--signal); outline-offset: 0.3rem; }
  .transcript-paragraphs > p > .transcript-paragraph-link {
    display: inline-block; margin-inline-start: 0.45em; color: var(--muted);
    font-size: 0.8em; font-weight: 700; opacity: 0; text-decoration: none;
  }
  .transcript-quote-paragraph:hover .transcript-paragraph-link,
  .transcript-quote-paragraph:target .transcript-paragraph-link,
  .transcript-paragraph-link:focus-visible { opacity: 1; }
  .transcript-paragraph-link:focus-visible { outline: var(--stroke-emphasis) solid var(--signal-text); }
  .transcript-paragraph-feedback { margin-inline-start: 0.4em; color: var(--muted); font-size: 0.75em; }
  .transcript-paragraph-feedback input { max-width: min(100%, 28rem); font: inherit; }
  @media (hover: none) { .transcript-paragraphs > p > .transcript-paragraph-link { opacity: 0.55; } }
}
</style>
