---
import InterfaceIcon from "./InterfaceIcon.astro";
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
  currentPath: string;
  alternatePath: string;
}

const { content, currentPath, alternatePath } = Astro.props;
const homePath = content.locale === "en" ? "/en" : "/";
const weeklyPath = content.locale === "en" ? "/en/weekly" : "/weekly";
const libraryPath = content.locale === "en" ? "/en/wiki" : "/wiki";
const communityPath = content.locale === "en" ? "/en/community" : "/community";
const blogPath = content.locale === "en" ? "/en/blog" : "/blog";
const isWeekly = currentPath.startsWith(weeklyPath);
const isLibrary = currentPath.startsWith(content.locale === "en" ? "/en/wiki" : "/wiki");
---

<header class="site-header">
  <div class="nav shell">
    <a class="wordmark" href={homePath} aria-label={content.homeLabel}>
      <img src="/assets/logo-next-token.svg?v=3" width="1024" height="1024" alt="" />
      <span class="wordmark-title">
        <span class="wordmark-name">Next Token</span>
        <span class="wordmark-divider" aria-hidden="true">｜</span>
        <span class="wordmark-tagline" lang="zh-Hans">词元之外</span>
      </span>
    </a>
    <nav class="nav-links" aria-label={content.navigationLabel}>
      <a href={weeklyPath} aria-current={isWeekly ? "page" : undefined}>{content.locale === "en" ? "Episodes" : "节目"}</a>
      <a href={blogPath} aria-current={currentPath === blogPath || currentPath.startsWith(`${blogPath}/`) ? "page" : undefined}>{content.locale === "en" ? "Blog" : "博客"}</a>
      <a class="library-link" href={libraryPath} aria-current={isLibrary ? "page" : undefined}>{content.navigation.library}</a>
      <a href={communityPath} aria-current={currentPath === communityPath ? "page" : undefined}>{content.locale === "en" ? "Community & Subscriptions" : "社群与订阅"}</a>
      <a class="search-link" aria-keyshortcuts="Meta+K Control+K" href={content.locale === "en" ? "/en/search" : "/search"} aria-label={content.locale === "en" ? "Search" : "搜索"}><InterfaceIcon name="search" /></a>
      <div class="language-switcher" aria-label={content.languageLabel}>
        <a href={content.locale === "zh-Hans" ? currentPath : alternatePath} lang="zh-Hans" data-language="zh-Hans" aria-current={content.locale === "zh-Hans" ? "page" : undefined}>中文</a>
        <span aria-hidden="true">/</span>
        <a href={content.locale === "en" ? currentPath : alternatePath} lang="en" data-language="en" aria-current={content.locale === "en" ? "page" : undefined}>EN</a>
      </div>
      <a class="status-pill" href={content.latestEpisodePath}>{content.status}</a>
    </nav>
    <details class="mobile-navigation">
      <summary aria-label={content.locale === "en" ? "Navigation menu" : "导航菜单"}>
        <span>{content.locale === "en" ? "Menu" : "菜单"}</span>
        <InterfaceIcon name="menu" />
      </summary>
    <nav class="mobile-nav-links" aria-label={content.navigationLabel}>
      <a href={weeklyPath} aria-current={isWeekly ? "page" : undefined}>{content.locale === "en" ? "Episodes" : "节目"}</a>
      <a href={blogPath} aria-current={currentPath === blogPath || currentPath.startsWith(`${blogPath}/`) ? "page" : undefined}>{content.locale === "en" ? "Blog" : "博客"}</a>
      <a class="library-link" href={libraryPath} aria-current={isLibrary ? "page" : undefined}>{content.navigation.library}</a>
      <a href={communityPath} aria-current={currentPath === communityPath ? "page" : undefined}>{content.locale === "en" ? "Community & Subscriptions" : "社群与订阅"}</a>
      <a class="search-link" aria-keyshortcuts="Meta+K Control+K" href={content.locale === "en" ? "/en/search" : "/search"} aria-label={content.locale === "en" ? "Search" : "搜索"}><InterfaceIcon name="search" /></a>
      <div class="language-switcher" aria-label={content.languageLabel}>
        <a href={content.locale === "zh-Hans" ? currentPath : alternatePath} lang="zh-Hans" data-language="zh-Hans" aria-current={content.locale === "zh-Hans" ? "page" : undefined}>中文</a>
        <span aria-hidden="true">/</span>
        <a href={content.locale === "en" ? currentPath : alternatePath} lang="en" data-language="en" aria-current={content.locale === "en" ? "page" : undefined}>EN</a>
      </div>
      <a class="mobile-latest" href={content.latestEpisodePath}>{content.status}</a>
    </nav>
    </details>
  </div>
</header>

<script>
  const searchLinks = document.querySelectorAll<HTMLAnchorElement>(".search-link");
  const shortcut = /Mac|iPhone|iPad/.test(navigator.userAgent) ? "⌘K" : "Ctrl+K";
  searchLinks.forEach(link => { link.title = `${link.getAttribute("aria-label")} (${shortcut})`; });
  document.addEventListener("keydown", (event) => {
    if (event.defaultPrevented || event.isComposing || event.altKey || event.shiftKey ||
        !(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== "k") return;
    const link = searchLinks[0];
    if (!link) return;
    event.preventDefault();
    if (event.repeat) return;
    const input = document.querySelector<HTMLInputElement>("[data-search-locale] #search-query");
    if (input) {
      const navigation = document.querySelector<HTMLDetailsElement>(".mobile-navigation");
      if (navigation) navigation.open = false;
      input.scrollIntoView({ block: "center", behavior: "instant" });
      input.focus({ preventScroll: true });
      input.select();
    } else {
      window.location.assign(`${link.href}#search-query`);
    }
  });
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-navigation");
  const toggle = menu?.querySelector("summary");
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      toggle?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
    if (event.matches && menu) menu.open = false;
  });
</script>

<style>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
.search-link { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; }
  .mobile-navigation { display: none; }
  @media (max-width: 900px) {
    .nav { position: relative; padding-block: .5rem; column-gap: 1rem; row-gap: .5rem; }
    .wordmark { min-width: 0; max-width: 100%; }
    .wordmark-title { min-width: 0; white-space: normal; }
    .wordmark-name { overflow-wrap: anywhere; }
    .nav-links { display: none; }
    .mobile-navigation { display: block; margin-inline-start: auto; }
    .mobile-navigation summary { display: flex; align-items: center; justify-content: center; gap: .6rem; min-width: 2.75rem; min-height: 2.75rem; padding: .5rem .75rem; border: var(--stroke-thin) solid var(--ink); border-radius: var(--control-radius); cursor: pointer; font-size: var(--type-ui); font-weight: 750; list-style: none; }
    .mobile-navigation summary::-webkit-details-marker { display: none; }
    .mobile-navigation summary:focus-visible, .mobile-nav-links a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
    .mobile-navigation[open] summary { color: var(--paper); background: var(--ink); }
    .mobile-nav-links { position: absolute; top: 100%; left: 0; right: 0; display: grid; gap: .25rem; max-height: calc(100dvh - 5rem); overflow-y: auto; overscroll-behavior: contain; padding: 1rem var(--gutter) 1.5rem; border-bottom: 1px solid var(--ink); background: var(--paper); box-shadow: var(--shadow-menu); }
    .mobile-nav-links > a { display: flex; align-items: center; min-height: 2.75rem; padding-block: .5rem; border-bottom: 1px solid var(--line); font-size: var(--type-base); font-weight: 750; }
    .mobile-nav-links > a[aria-current="page"] { text-decoration: underline; text-underline-offset: calc(.3rem + var(--link-underline-gap)); }
    .mobile-nav-links .language-switcher { justify-content: flex-start; gap: 1rem; }
    .mobile-nav-links .language-switcher a { display: inline-flex; align-items: center; min-height: 2.75rem; }
    .mobile-nav-links .mobile-latest { border-bottom: 0; }
  }
}
</style>
