---
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
  currentPath: string;
  alternatePath: string;
}

const { content, currentPath, alternatePath } = Astro.props;
const homePath = content.locale === "en" ? "/en" : "/";
const partnersPath = content.locale === "en" ? "/en/partners" : "/partners";
const weeklyPath = content.locale === "en" ? "/en/weekly" : "/weekly";
const libraryPath = content.locale === "en" ? "/en/wiki" : "/wiki";
const homeSection = (id: string) => currentPath === homePath ? `#${id}` : `${homePath}#${id}`;
const isPartners = currentPath.startsWith(partnersPath);
const isWeekly = currentPath.startsWith(weeklyPath);
const isLibrary = currentPath.startsWith(content.locale === "en" ? "/en/wiki" : "/wiki");
---

<header class="site-header">
  <div class="nav shell">
    <a class="wordmark" href={homePath} aria-label={content.homeLabel}>
      <img src="/assets/logo-next-token.svg?v=3" width="1024" height="1024" alt="" />
      <span class="wordmark-title">
        <span class="wordmark-name">Next Token</span>
        <span class="wordmark-divider" aria-hidden="true">|</span>
        <span class="wordmark-tagline" lang="zh-Hans">词元之外</span>
      </span>
    </a>
    <nav class="nav-links" aria-label={content.navigationLabel}>
      <a href={homeSection("about")}>{content.navigation.about}</a>
      <a href={weeklyPath} aria-current={isWeekly ? "page" : undefined}>{content.navigation.weekly}</a>
      <a class="library-link" href={libraryPath} aria-current={isLibrary ? "page" : undefined}>{content.navigation.library}</a>
      <a href={homeSection("hosts")}>{content.navigation.hosts}</a>
      <a class="partners-link" href={partnersPath} aria-current={isPartners ? "page" : undefined}>{content.navigation.partners}</a>
      <a href={homeSection("subscribe")}>{content.navigation.subscribe}</a>
      <a class="search-link" href={content.locale === "en" ? "/en/search" : "/search"} aria-label={content.locale === "en" ? "Search" : "搜索"}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="2" /><path d="m15 15 6 6" stroke="currentColor" stroke-width="2" /></svg></a>
      <div class="language-switcher" aria-label={content.languageLabel}>
        <a href={content.locale === "zh-Hans" ? currentPath : alternatePath} lang="zh-Hans" data-language="zh-Hans" aria-current={content.locale === "zh-Hans" ? "page" : undefined}>中文</a>
        <span aria-hidden="true">/</span>
        <a href={content.locale === "en" ? currentPath : alternatePath} lang="en" data-language="en" aria-current={content.locale === "en" ? "page" : undefined}>EN</a>
      </div>
      <a class="status-pill" href={content.latestEpisodePath}>{content.status}</a>
    </nav>
    <details class="mobile-navigation">
      <summary aria-label={content.locale === "en" ? "Navigation menu" : "导航菜单"}>
        <span>{content.locale === "en" ? "Menu" : "菜单"}</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" /></svg>
      </summary>
    <nav class="mobile-nav-links" aria-label={content.navigationLabel}>
      <a href={homeSection("about")}>{content.navigation.about}</a>
      <a href={weeklyPath} aria-current={isWeekly ? "page" : undefined}>{content.navigation.weekly}</a>
      <a class="library-link" href={libraryPath} aria-current={isLibrary ? "page" : undefined}>{content.navigation.library}</a>
      <a href={homeSection("hosts")}>{content.navigation.hosts}</a>
      <a class="partners-link" href={partnersPath} aria-current={isPartners ? "page" : undefined}>{content.navigation.partners}</a>
      <a href={homeSection("subscribe")}>{content.navigation.subscribe}</a>
      <a class="search-link" href={content.locale === "en" ? "/en/search" : "/search"} aria-label={content.locale === "en" ? "Search" : "搜索"}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="2" /><path d="m15 15 6 6" stroke="currentColor" stroke-width="2" /></svg></a>
      <div class="language-switcher" aria-label={content.languageLabel}>
        <a href={content.locale === "zh-Hans" ? currentPath : alternatePath} lang="zh-Hans" data-language="zh-Hans" aria-current={content.locale === "zh-Hans" ? "page" : undefined}>中文</a>
        <span aria-hidden="true">/</span>
        <a href={content.locale === "en" ? currentPath : alternatePath} lang="en" data-language="en" aria-current={content.locale === "en" ? "page" : undefined}>EN</a>
      </div>
      <a class="mobile-latest" href={content.latestEpisodePath}>{content.status}</a>
    </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-navigation");
  const toggle = menu?.querySelector("summary");
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      toggle?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
    if (event.matches && menu) menu.open = false;
  });
</script>

<style>
  .search-link { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; }
  .mobile-navigation { display: none; }
  @media (max-width: 900px) {
    .nav { position: relative; }
    .nav-links { display: none; }
    .mobile-navigation { display: block; }
    .mobile-navigation summary { display: flex; align-items: center; justify-content: center; gap: .6rem; min-width: 2.75rem; min-height: 2.75rem; padding: .5rem .75rem; border: 1px solid var(--ink); cursor: pointer; font-size: .875rem; font-weight: 750; list-style: none; }
    .mobile-navigation summary::-webkit-details-marker { display: none; }
    .mobile-navigation summary:focus-visible, .mobile-nav-links a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
    .mobile-navigation[open] summary { color: var(--paper); background: var(--ink); }
    .mobile-nav-links { position: absolute; top: 100%; left: 0; right: 0; display: grid; gap: .25rem; max-height: calc(100dvh - 5rem); overflow-y: auto; overscroll-behavior: contain; padding: 1rem var(--gutter) 1.5rem; border-bottom: 1px solid var(--ink); background: var(--paper); box-shadow: 0 .75rem 1.5rem rgb(0 0 0 / 8%); }
    .mobile-nav-links > a { display: flex; align-items: center; min-height: 2.75rem; padding-block: .5rem; border-bottom: 1px solid var(--line); font-size: 1rem; font-weight: 750; }
    .mobile-nav-links > a[aria-current="page"] { text-decoration: underline; text-underline-offset: .3rem; }
    .mobile-nav-links .language-switcher { justify-content: flex-start; gap: 1rem; }
    .mobile-nav-links .language-switcher a { display: inline-flex; align-items: center; min-height: 2.75rem; }
    .mobile-nav-links .mobile-latest { border-bottom: 0; }
  }
</style>
