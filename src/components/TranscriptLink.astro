---
import { getEpisodeTranscriptOrNull } from "../data/catalog";
import type { Locale } from "../data/types";
interface Props { episodeId: string; number: string; locale: Locale; variant?: "default" | "light" | "inline"; details?: boolean; showNumber?: boolean }
const { episodeId, number, locale, variant = "default", details = false, showNumber = false } = Astro.props;
const localizedTranscript = await getEpisodeTranscriptOrNull(episodeId, locale);
const transcript = localizedTranscript ?? (locale === "en" ? await getEpisodeTranscriptOrNull(episodeId, "zh-Hans") : null);
const transcriptLocale = transcript?.data.locale ?? locale;
const chineseFallback = locale === "en" && transcriptLocale === "zh-Hans";
const isPublished = transcript?.data.publicationStatus === "published";
const isLocalPreview = import.meta.env.DEV && transcript?.data.publicationStatus === "review-draft";
// Pages in the other language stay free of transcript links when only the other locale's transcript exists.
const showCta = (isPublished || isLocalPreview) && (locale === "zh-Hans" || !!localizedTranscript);
---
{showCta && (
  <>
    <a class:list={["episode-transcript-cta", `transcript-cta--${variant}`]} href={`${transcriptLocale === "en" ? "/en" : ""}/weekly/${number}/transcript`}>
      {showNumber && <>#{number} · </>}{locale === "en" ? (chineseFallback ? "Read the transcript (Chinese)" : details ? "Read the full transcript" : "Read the transcript") : (details ? "阅读完整文字稿" : "阅读文字稿")} <span aria-hidden="true">→</span>
    </a>
    {details && <p class="transcript-cta-description">{transcript.data.chapters.length} {locale === "en" ? "chapters · Full-text search" : "个章节 · 支持全文搜索"}</p>}
  </>
)}
