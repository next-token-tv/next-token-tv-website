---
import { getEpisodeTranscriptOrNull } from "../data/catalog";
import type { Locale } from "../data/types";
interface Props { episodeId: string; number: string; locale: Locale; variant?: "default" | "light" | "inline"; details?: boolean }
const { episodeId, number, locale, variant = "default", details = false } = Astro.props;
const transcript = await getEpisodeTranscriptOrNull(episodeId, locale);
---
{transcript && (
  <>
    <a class:list={["episode-transcript-cta", `transcript-cta--${variant}`]} href={`${locale === "en" ? "/en" : ""}/weekly/${number}/transcript/`}>
      {locale === "en" ? (details ? "Read the full transcript" : "Read the transcript") : (details ? "阅读完整文字稿" : "阅读文字稿")} <span aria-hidden="true">→</span>
    </a>
    {details && <p class="transcript-cta-description">{transcript.data.chapters.length} {locale === "en" ? "chapters · Full-text search" : "个章节 · 支持全文搜索"}</p>}
  </>
)}
