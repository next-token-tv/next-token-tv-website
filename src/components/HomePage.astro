---
import CommunityJoin from "./CommunityJoin.astro";
import EpisodeCard from "./EpisodeCard.astro";
import LatestTranscriptLink from "./LatestTranscriptLink.astro";
import UpcomingEpisodeLink from "./UpcomingEpisodeLink.astro";
import ShowSubscriptions from "./ShowSubscriptions.astro";
import HostCard from "./HostCard.astro";
import ConditionalImagePan from "./ConditionalImagePan.astro";
import { getLatestVisibleEpisode, getSocialPlatformOrder } from "../data/catalog";
import BrandHeroVisual from "./BrandHeroVisual.astro";
import type { HeroEpisodes } from "../data/hero-episodes";
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
  heroEpisodes?: HeroEpisodes;
}

const { content, heroEpisodes } = Astro.props;
const availablePlatforms = getSocialPlatformOrder(content.locale).filter(platform => content.hosts.items.some(host => host.socials.some(social => social.platform === platform)));
const platformHostCount = (platform: string) => content.hosts.items.filter(host => host.socials.some(social => social.platform === platform)).length;
const socialPlatforms = availablePlatforms.toSorted((a, b) => platformHostCount(b) - platformHostCount(a));
const compactPlatforms = socialPlatforms.filter(platform => platformHostCount(platform) < content.hosts.items.length);
const socialRowCount = socialPlatforms.length - compactPlatforms.length + Math.max(0, ...content.hosts.items.map(host => compactPlatforms.filter(platform => host.socials.some(social => social.platform === platform)).length));
const latestEpisode = heroEpisodes?.latest ?? await getLatestVisibleEpisode();
const latestEpisodePath = `${content.locale === "en" ? "/en" : ""}/weekly/${latestEpisode.data.number}`;
---

<main id="main">
  <section class="hero" id="top">
    <div class="hero-grid shell">
    <div class="hero-copy">
      <div>
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1>
          {content.hero.headingLead.split("\n").map((line, index, lines) => (
            <>{line}{index < lines.length - 1 && <br />}</>
          ))}<span class="accent">{content.hero.headingAccent}</span>
        </h1>
        <p class="hero-intro">{content.hero.intro}</p>
        <div class="actions">
          <a class="button primary" href={latestEpisodePath}>{content.hero.primaryAction} <span aria-hidden="true">↘</span></a>
          <LatestTranscriptLink locale={content.locale} episode={heroEpisodes?.transcript} />
          <a class="hero-about-link" href={`${content.locale === "en" ? "/en" : ""}/weekly#episodes`}>{content.locale === "en" ? "All episodes" : "全部节目"} →</a>
        </div>
        <UpcomingEpisodeLink locale={content.locale} episode={heroEpisodes?.upcoming} />
      </div>
    </div>

    <BrandHeroVisual locale={content.locale} />
    </div>
  </section>

  <div class="topic-rail">
    <div class="topic-rail-viewport" aria-hidden="true">
      <div class="rail-track">
        {[0, 1].map(() => (
          <div class="rail-set">
            {[...content.topics, ...content.topics, ...content.topics].map((topic) => <span class="rail-item"><span class="rail-label">{topic}</span></span>)}
          </div>
        ))}
      </div>
    </div>
    <button class="topic-rail-toggle" type="button" hidden
      data-pause-label={content.locale === 'en' ? 'Pause topic ticker' : '暂停主题滚动'}
      data-play-label={content.locale === 'en' ? 'Resume topic ticker' : '继续主题滚动'}>
      <span data-pause-icon aria-hidden="true">Ⅱ</span><span data-play-icon aria-hidden="true">▶</span>
    </button>
  </div>

  <section class="section shell" id="about">
    <div class="section-heading" data-reveal>
      <p class="section-index">01 / The Brand</p>
      <div>
        <h2 class="heading-section-display home-section-heading">{content.about.heading[0]}<br />{content.about.heading[1]}</h2>
        <p class="section-lede">{content.about.lede}</p>
        <p class="about-brand-note">{content.hero.footnote}</p>
      </div>
    </div>

    <div class="brand-manifesto" data-reveal>
      {content.about.cards.map((card, index) => (
        <article class:list={["manifesto-card", { featured: index === 0 }]}>
          <span class="number">{String(index + 1).padStart(2, "0")}</span>
          <h3>{card.title}</h3>
          <p>{card.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section weekly" id="weekly">
    <div class="shell">
    <div class="section-heading" data-reveal>
      <p class="section-index">02 / The Flagship</p>
      <div>
        <h2 class="heading-section-display home-section-heading">Next Token Weekly</h2>
        <p class="section-lede">{content.weekly.lede}</p>
      </div>
    </div>

    <EpisodeCard episodeId={latestEpisode.id} locale={content.locale} />
    <p class="type-ui"><a class="text-link" href={content.locale === "en" ? "/en/skill" : "/skill"}>{content.locale === "en" ? "Let your agent cite Next Token" : "让你的 Agent 引用 Next Token 节目"} <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section shell" id="hosts">
    <div class="hosts-header" data-reveal>
      <div>
        <p class="section-index">03 / The Hosts</p>
        <h2 class="heading-section-display home-section-heading">{content.hosts.heading[0]}<br />{content.hosts.heading[1]}</h2>
      </div>
      <p class="hosts-note">{content.hosts.note}</p>
    </div>

    <div class="host-grid" data-reveal>
      {content.hosts.items.map((host) => <HostCard host={host} socialPlatforms={socialPlatforms} compactPlatforms={compactPlatforms} socialRowCount={socialRowCount} />)}
    </div>
  </section>

  <section class="section shell subscribe" id="subscribe">
    <div class="subscribe-copy" data-reveal>
      <p class="section-index">04 / Follow the Signal</p>
      <h2 class="heading-follow-display home-section-heading">{content.subscribe.heading[0]}<br />{content.subscribe.heading[1]}</h2>
      <p>{content.subscribe.copy}</p>
      <CommunityJoin locale={content.locale} id="community" showDiscord={false} />
    </div>
    <ShowSubscriptions locale={content.locale} reveal />
  </section>
</main>

<ConditionalImagePan />


<script>
  const rail = document.querySelector<HTMLElement>(".topic-rail");
  const toggle = rail?.querySelector<HTMLButtonElement>(".topic-rail-toggle");
  if (rail && toggle) {
    const updateLabel = () => {
      const label = rail.hasAttribute("data-paused") ? toggle.dataset.playLabel! : toggle.dataset.pauseLabel!;
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
    };
    toggle.addEventListener("click", () => {
      rail.toggleAttribute("data-paused");
      updateLabel();
    });
    updateLabel();
    toggle.hidden = false;
    rail.setAttribute("data-motion-ready", "");
  }

  if (matchMedia("(prefers-reduced-motion: no-preference)").matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("reveal-entered");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14 },
    );
    document.querySelectorAll("[data-reveal]").forEach((item) => observer.observe(item));
  }
</script>
