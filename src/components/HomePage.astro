---
import TranscriptLink from "./TranscriptLink.astro";
import UpcomingEpisodeLink from "./UpcomingEpisodeLink.astro";
import ShowSubscriptions from "./ShowSubscriptions.astro";
import HostCard from "./HostCard.astro";
import ConditionalImagePan from "./ConditionalImagePan.astro";
import { getPublishedEpisode } from "../data/catalog";
import { resolveVenueId } from "../data/partners";
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const episode001 = await getPublishedEpisode();
const episode001Assets = {
  id: episode001.data.number,
  recordedAt: episode001.data.recordedAt,
  images: episode001.data.images,
};
const episode001Recording = await resolveVenueId(episode001.data.recordingVenue);
const episode001VenueLabel = content.locale === "en"
  ? `${episode001Recording.partner.englishName} · ${episode001Recording.venue.name.en}`
  : `${episode001Recording.partner.name} · ${episode001Recording.venue.name["zh-Hans"]}`;

const episode001Path = content.locale === "en" ? "/en/weekly/001/" : "/weekly/001/";
---

<main id="main">
  <section class="hero" id="top">
    <div class="hero-grid shell">
    <div class="hero-copy">
      <div data-reveal>
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1>
          {content.hero.headingLead.split("\n").map((line, index, lines) => (
            <>{line}{index < lines.length - 1 && <br />}</>
          ))}<span class="accent">{content.hero.headingAccent}</span>
        </h1>
        <p class="hero-intro">{content.hero.intro}</p>
        <div class="actions">
          <a class="button primary" href={episode001Path}>{content.hero.primaryAction} <span aria-hidden="true">↘</span></a>
          <a class="button" href="#about">{content.hero.secondaryAction}</a>
        </div>
        <UpcomingEpisodeLink locale={content.locale} />
      </div>
      <div class="hero-footnote" data-reveal>
        <strong>NT.</strong>
        <p>{content.hero.footnote}</p>
      </div>
    </div>

    <div class="hero-visual" aria-label={content.hero.visualLabel}>
      <img
        class="pan-if-cropped"
        data-pan-if-cropped
        src={episode001Assets.images["960"]}
        srcset={`${episode001Assets.images["960"]} 960w, ${episode001Assets.images["1440"]} 1440w, ${episode001Assets.images["1920"]} 1920w`}
        sizes="(max-width: 1000px) 100vw, (min-width: 1600px) 700px, 48vw"
        width="1920"
        height="1080"
        decoding="async"
        fetchpriority="high"
        alt={content.hero.visualAlt}
      />
      <div class="episode-stamp">Weekly<br />#{episode001Assets.id}</div>
      <div class="visual-caption">
        <strong>24 signals<br />one open table</strong>
        <span class="recording-caption">
          <span>Recorded · {episode001Assets.recordedAt.replaceAll("-", ".")}</span>
          <span>· {episode001VenueLabel}</span>
        </span>
      </div>
    </div>
    </div>
  </section>

  <div class="topic-rail" aria-hidden="true">
    <div class="rail-track">
      {[0, 1].map(() => (
        <div class="rail-set">
          {content.topics.map((topic) => <span class="rail-item"><span class="rail-label">{topic}</span></span>)}
        </div>
      ))}
    </div>
  </div>

  <section class="section shell" id="about">
    <div class="section-heading" data-reveal>
      <p class="section-index">01 / The Brand</p>
      <div>
        <h2 class="heading-section-display">{content.about.heading[0]}<br />{content.about.heading[1]}</h2>
        <p class="section-lede">{content.about.lede}</p>
      </div>
    </div>

    <div class="brand-manifesto" data-reveal>
      {content.about.cards.map((card, index) => (
        <article class:list={["manifesto-card", { featured: index === 0 }]}>
          <span class="number">{String(index + 1).padStart(2, "0")}</span>
          <h3>{card.title}{card.titleSecondLine && <><br />{card.titleSecondLine}</>}</h3>
          <p>{card.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section weekly" id="weekly">
    <div class="shell">
    <div class="section-heading" data-reveal>
      <p class="section-index">02 / The Flagship</p>
      <div>
        <h2 class="heading-section-display">Next Token<br />Weekly</h2>
        <p class="section-lede">{content.weekly.lede}</p>
      </div>
    </div>

    <article class="weekly-card" data-reveal>
      <div class="weekly-image">
        <img
          class="pan-if-cropped"
          data-pan-if-cropped
          src={episode001Assets.images["960"]}
          srcset={`${episode001Assets.images["960"]} 960w, ${episode001Assets.images["1440"]} 1440w, ${episode001Assets.images["1920"]} 1920w`}
          sizes="(max-width: 1000px) 100vw, 50vw"
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
          alt={content.weekly.imageAlt}
        />
        <span class="label">Recorded 09.03 · {episode001VenueLabel}</span>
      </div>
      <div class="weekly-copy">
        <div class="episode-number">#{episode001Assets.id}</div>
        <div>
          <p class="eyebrow">{content.weekly.eyebrow}</p>
          <h3>{content.weekly.heading[0]}<br />{content.weekly.heading[1]}</h3>
          <p>{content.weekly.copy}</p>
          <div class="episode-meta" aria-label={content.weekly.topicsLabel}>
            {content.weekly.topics.map((topic) => <span>{topic}</span>)}
          </div>
          <div class="episode-actions">
            <a class="episode-listen" href={episode001Path}>
              {content.locale === "en" ? "Explore episode · Listen / watch" : "查看本期 · 收听/收看"} <span aria-hidden="true">↗</span>
            </a>
            <TranscriptLink episodeId={episode001.id} number={episode001.data.number} locale={content.locale} />
          </div>
        </div>
      </div>
    </article>
    </div>
  </section>

  <section class="section shell" id="hosts">
    <div class="hosts-header" data-reveal>
      <div>
        <p class="section-index">03 / The Hosts</p>
        <h2 class="heading-section-display">{content.hosts.heading[0]}<br />{content.hosts.heading[1]}</h2>
      </div>
      <p class="hosts-note">{content.hosts.note}</p>
    </div>

    <div class="host-grid" data-reveal>
      {content.hosts.items.map((host) => <HostCard host={host} />)}
    </div>
  </section>

  <section class="section shell subscribe" id="subscribe">
    <div class="subscribe-copy" data-reveal>
      <p class="section-index">04 / Follow the Signal</p>
      <h2 class="heading-section-display">{content.subscribe.heading[0]}<br />{content.subscribe.heading[1]}</h2>
      <p>{content.subscribe.copy}</p>
    </div>
    <ShowSubscriptions locale={content.locale} reveal />
  </section>
</main>

<ConditionalImagePan />

<script>
  const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14 },
    );
    revealItems.forEach((item) => observer.observe(item));
  }
</script>
