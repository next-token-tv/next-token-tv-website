---
import type { Locale } from "../data/types";

interface Props {
  episodeNumber: string;
  locale: Locale;
  title: string;
  tracks: {
    platform: "youtube" | "bilibili";
    href: string;
    times: Record<string, [number, number]>;
  }[];
}
const { episodeNumber, locale, title, tracks } = Astro.props;
const copy = locale === "en" ? {
  launch: "Make a clip", toolbar: "Select a clip range", exit: "Exit", reset: "Reset", preview: "Preview clip",
  title: "Clip preview", video: "Video timestamps", quote: "Selected transcript", details: "View citation",
  citation: "Clip citation", adjust: "Back to selection", copy: "Copy clip citation", close: "Close",
} : {
  launch: "制作切片", toolbar: "切片选段", exit: "退出", reset: "重选", preview: "预览切片",
  title: "切片预览", video: "视频定位", quote: "选中原文", details: "查看引用内容",
  citation: "切片引用", adjust: "返回调整", copy: "复制切片引用", close: "关闭",
};
---

<div hidden data-clip-tools data-clip-locale={locale} data-episode-number={episodeNumber} data-episode-title={title}
  data-clip-tracks={JSON.stringify(tracks.map(({ platform, href, times }) => ({ platform, href, times })))}>
  <button type="button" class="button primary transcript-clip-launch" data-clip-launch>{copy.launch}</button>

  <section class="transcript-clip-toolbar" aria-label={copy.toolbar} hidden data-clip-toolbar>
    <div class="transcript-clip-instructions">
      <strong role="status" data-clip-status></strong>
      <span data-clip-hint></span>
    </div>
    <div class="transcript-clip-actions">
      <button type="button" class="button" data-clip-exit>{copy.exit}</button>
      <button type="button" class="button" hidden data-clip-reset>{copy.reset}</button>
      <button type="button" class="button primary" disabled aria-haspopup="dialog" data-clip-preview>{copy.preview}</button>
    </div>
  </section>

  <dialog class="transcript-clip-dialog" aria-labelledby="transcript-clip-title" data-clip-dialog>
    <div class="transcript-clip-dialog-header">
      <h2 id="transcript-clip-title" class="heading-section-content">{copy.title}</h2>
      <span data-clip-preview-summary></span>
    </div>

    <div class="transcript-clip-dialog-content">
      <ul class="transcript-clip-video" aria-label={copy.video} data-clip-video></ul>
      <blockquote class="transcript-clip-quotes" aria-label={copy.quote} data-clip-quotes></blockquote>
      <details class="transcript-clip-prompt" data-clip-prompt-details>
        <summary>{copy.details}</summary>
        <textarea readonly aria-label={copy.citation} rows="8" id="transcript-clip-prompt"></textarea>
      </details>
    </div>

    <div class="transcript-clip-dialog-footer">
      <form method="dialog" class="transcript-clip-actions">
        <button type="submit" class="button" value="adjust">{copy.adjust}</button>
        <button type="button" class="button primary" autofocus command="--copy"
          commandfor="transcript-clip-prompt" data-clip-copy>{copy.copy}</button>
        <button type="submit" class="button transcript-clip-close" value="exit">{copy.close}</button>
      </form>
      <p role="status" data-clip-copy-status></p>
    </div>
  </dialog>
</div>
