---
import type { Locale } from "../data/types";
import ArticleReadingLayout from "./ArticleReadingLayout.astro";
import { render, type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDetailEpisode } from "../data/catalog";
import { getSiteContent } from "../data/site";
interface Props { article: CollectionEntry<"blog"> | CollectionEntry<"blogEn">; locale: Locale; }
const { article, locale } = Astro.props;
const prefix = locale === "en" ? "/en" : "";
const copy = (zh: string, en: string) => locale === "en" ? en : zh;
const { Content, headings } = await render(article);
if (headings.some(heading => heading.depth === 1)) throw new Error(`Article ${article.id} must not contain a second H1`);
const content = await getSiteContent(locale);
const episodes = await Promise.all(article.data.episodes.map(id => getDetailEpisode(id)));
const episode = episodes[0]!;
const number = episode.data.number;
const episodePath = `${prefix}/weekly/${number}`;
const path = `${prefix}/blog/${article.id}`;
const draft = article.data.status === "draft";
const hasAlternate = locale === "en" || (await getCollection("blogEn")).some(post => post.id === article.id);
const authorPath = `${prefix}/blog#editorial`;
const schema = {
  "@context": "https://schema.org", "@type": "Article", headline: article.data.title,
  description: article.data.description, inLanguage: locale,
  datePublished: article.data.publishedAt, dateModified: article.data.updatedAt,
  mainEntityOfPage: new URL(path, Astro.site).href,
  isBasedOn: episodes.map(entry => new URL(`/weekly/${entry.data.number}/transcript`, Astro.site).href),
  author: { "@type": "Organization", "@id": new URL("/blog#editorial", Astro.site).href, name: "Next Token", url: new URL(authorPath, Astro.site).href },
  publisher: { "@type": "Organization", name: "Next Token｜词元之外", url: Astro.site?.href },
};
---
<BaseLayout content={content} pageTitle={article.data.title} description={article.data.description} canonicalPath={path} hasLocaleAlternate={hasAlternate} alternatePath={hasAlternate ? `${locale === "en" ? "" : "/en"}/blog/${article.id}` : undefined} noIndex={draft} ogType="article" markdownPath={`${path}.md`}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
  <ArticleReadingLayout locale={locale} title={article.data.title} description={article.data.description} path={path} episodePath={episodePath} headings={headings} footerLabel={copy("来源节目", "Source episodes")}>
    <Fragment slot="context">{locale === "en" ? <a class="article-back" href="/en/blog">← All blog articles</a> : <nav class="article-context" aria-label="博客导航">
        <a href="/blog">所有博客文章</a>
        {episodes.map(entry => <a href={`/blog/episodes/${entry.data.number}`}>第 {entry.data.number} 期相关博客</a>)}
      </nav>}</Fragment>
    <Fragment slot="kicker">{copy("博客 / WEEKLY #", "Blog / WEEKLY #")}{number}{draft && copy(" · 审阅稿", " · Under review")}</Fragment>
    <Fragment slot="meta"><a href={authorPath} rel="author">{copy("Next Token 编辑整理", "Next Token Editorial")}</a><time datetime={article.data.publishedAt ?? article.data.updatedAt}>{article.data.publishedAt ?? article.data.updatedAt}</time>{draft && <span>{copy("待审核 · 尚未发布", "Under review · Not yet published")}</span>}</Fragment>
    <Fragment slot="source">{copy(
      `整理自 ${episodes.map(entry => `Weekly #${entry.data.number}（${entry.data.recordedAt}）`).join("、")}。文中体验与判断对应录制时的讨论。`,
      `Compiled from ${episodes.map(entry => `Weekly #${entry.data.number} (recorded ${entry.data.recordedAt})`).join(", ")}. Experiences and judgments reflect the discussion at recording time.`
    )}</Fragment>
    <Content />
    <Fragment slot="footer">{episodes.map(entry => <a href={`${prefix}/weekly/${entry.data.number}/transcript`}>Weekly #{entry.data.number}{copy(" · 完整文字稿 →", " · Full transcript →")}</a>)}<a href={`${prefix}/blog`}>{copy("更多博客文章 →", "More blog articles →")}</a></Fragment>
  </ArticleReadingLayout>
</BaseLayout>
