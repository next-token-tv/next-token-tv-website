---
import type { Locale } from "../data/types";
import { getShowPageData } from "../data/catalog";
import { platformAssets, platformIcon } from "../data/platforms.mjs";
import { interfaceIcons, type InterfaceIconName } from "../data/interface-icons";
import InterfaceIcon from "./InterfaceIcon.astro";
import PlatformBrand from "./PlatformBrand.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === "en";
const t = (zh: string, english: string) => en ? english : zh;
const show = await getShowPageData("next-token-weekly", locale);
const platforms = show.data.subscriptions.filter(item => platformIcon(item.platform));
---
<div class="ds-icons">

  <h3>{t("功能图标", "Interface icons")}</h3>
  <p class="ds-icon-note">{t("用色：继承所在控件的文字色。默认使用墨黑；浅底上的强调图标使用信号橙文字色，反色区域使用暖白。品牌基准橙用于 Logo 与图形。", "Color: inherit the control's text color. Use Ink Black by default, the Signal Orange text variant for accents on light surfaces, and Warm White on inverse surfaces. The base orange is used for the logo and graphics.")} <a class="text-link" href="#color">{t("颜色规范", "Color specifications")} →</a></p>
  <p class="ds-icon-note">{t("线形图标使用平直端点，颜色为 currentColor。尺寸使用 rem，描边随 SVG 视口等比缩放。图标作为装饰时隐藏于辅助技术；独立操作由按钮或链接提供可访问名称。", "Line icons use flat stroke ends and currentColor. Sizes use rem, with strokes scaling proportionally to the SVG viewport. Decorative icons are hidden from assistive technology; icon-only controls have an accessible name on their button or link.")}</p>
  <div class="ds-icon-grid" data-icon-group="interface">
    {(Object.keys(interfaceIcons) as InterfaceIconName[]).map(name => {
      const icon = interfaceIcons[name];
      return <article class="ds-icon-item">
        <div class="ds-icon-preview"><InterfaceIcon name={name} /></div>
        <h4>{icon.name[locale]}</h4><code>{name}</code>
        <p>{icon.usage[locale]}</p>
        <dl><div><dt>{t("尺寸", "Size")}</dt><dd>{icon.size}rem · {icon.size * 16}px</dd></div><div><dt>viewBox</dt><dd>{icon.viewBox}</dd></div><div><dt>{t("描边", "Stroke")}</dt><dd>{icon.stroke} {t("视口单位", "viewBox units")}</dd></div></dl>
      </article>;
    })}
  </div>
  <p class="ds-icon-note">{t("尺寸中的 px 按根字号 16px 换算。搜索图标的实际描边为 1.5px，菜单图标为 1.5px；根字号变化时同步缩放。", "Pixel equivalents assume a 16px root. Search and menu strokes both render at 1.5px at that root size and scale with text preferences.")}</p>

  <h3>{t("媒体平台", "Media platforms")}</h3>
  <p class="ds-icon-note">{t("媒体平台标识使用各平台的品牌颜色，保留素材自身配色。", "Media-platform marks use their respective brand colors and retain the colors defined in each asset.")}</p>
  <p class="ds-icon-note">{t("订阅入口使用 1.75rem × 1.75rem 图标区域，与名称间距为 0.65rem。各素材的光学尺寸见下方标注；图形居中，保留原始比例、配色与留白，不拉伸、不裁剪、不重绘。", "Subscription marks use a 1.75rem square slot and a 0.65rem name gap. Optical sizes are listed below. Marks are centered with their original proportions, colors and clear space, without stretching, cropping or redrawing.")}</p>
  <div class="ds-icon-grid" data-icon-group="platform">
    {platforms.map(item => {
      const src = platformIcon(item.platform)!;
      const asset = platformAssets[item.platform as keyof typeof platformAssets];
      const sourceLabel = asset.kind === "official" ? t("官方素材", "Official asset") : asset.kind === "official-adapted" ? t("官方图形 · 适配版", "Official artwork · adapted") : t("第三方素材", "Third-party asset");
      return <article class="ds-icon-item">
        <div class="ds-platform-preview"><PlatformBrand platform={item.platform} name={item.label[locale]} /></div>
        <p class="ds-icon-format">{src.endsWith(".svg") ? "SVG" : "PNG"} · {asset.size}rem / {asset.size * 16}px</p>
        <a class="text-link" href={asset.source} target="_blank" rel="noopener noreferrer">{sourceLabel} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={src} download>{t("下载素材", "Download asset")} <span aria-hidden="true">↓</span></a>
      </article>;
    })}
  </div>
  <p class="ds-icon-note">{t("Spotify、YouTube 和微信公众号使用官方 SVG；Apple Podcasts 使用官方 PNG。视频号采用官方网站的矢量图形与平台橙色；小宇宙采用官方固定标签页矢量图形与官网蓝色。哔哩哔哩采用官网小电视矢量与平台粉色，小红书采用官网页头的 PNG 字标。素材按标注格式使用，展示尺寸与对齐方式遵循图标规范。", "Spotify, YouTube and WeChat Official Accounts use official SVGs; Apple Podcasts uses an official PNG. WeChat Channels uses its official site's vector artwork and orange; Xiaoyuzhou uses its official pinned-tab vector and website blue. Bilibili uses the official site’s TV vector and pink; RedNote uses the official site’s header PNG wordmark. Assets use their listed file formats and the specified display sizes and alignment.")}</p>

  <div class="ds-symbol-note"><h3>{t("文字符号", "Text symbols")}</h3><p><span aria-hidden="true">→ ↗ ↘ ↓ × ✓</span></p><p>{t("箭头、关闭符号和状态符号由字体绘制，不属于 SVG 图标。二维码属于内容图片，不纳入图标库。", "Arrows, close symbols and status symbols are font glyphs, not SVG icons. QR codes are content images and are not part of the icon library.")}</p></div>
</div>
<style>
@import "../styles/components/design-system-icons.css";
</style>
