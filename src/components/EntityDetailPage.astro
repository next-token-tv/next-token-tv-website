---
import "../styles/wiki-detail.css";
import WikiDetailHeader from "./WikiDetailHeader.astro";
import WikiIdentityCard from "./WikiIdentityCard.astro";
import { getBrandProfile, getProductProfile, getWikiArticle } from "../data/catalog";
import type { Locale } from "../data/types";
import { displayAliases } from "../data/entity-aliases";
import WikiArticle from "./WikiArticle.astro";
import RelatedEpisodes from "./RelatedEpisodes.astro";
import EntityPeopleRelations from "./EntityPeopleRelations.astro";

interface Props {
  entityType: "brand" | "product";
  entityId: string;
  locale: Locale;
}

const { entityType, entityId, locale } = Astro.props;
const article = await getWikiArticle(entityType, entityId, locale);
const prefix = locale === "en" ? "/en" : "";
const brandKind = {
  "ai-brand": { "zh-Hans": "人工智能", en: "Artificial intelligence" },
  "hardware-brand": { "zh-Hans": "硬件与半导体", en: "Hardware & semiconductors" },
  "internet-software-brand": { "zh-Hans": "互联网与软件服务", en: "Internet & software services" },
  "media-community-brand": { "zh-Hans": "媒体与社区", en: "Media & communities" },
  "other-brand": { "zh-Hans": "其他", en: "Other" },
} as const;
const productKind = {
  "model-family": { "zh-Hans": "模型家族", en: "Model family" }, model: { "zh-Hans": "模型", en: "Model" },
  show: { "zh-Hans": "节目", en: "Show" },
  game: { "zh-Hans": "游戏", en: "Game" },
  book: { "zh-Hans": "图书", en: "Book" },
  "operating-system": { "zh-Hans": "操作系统", en: "Operating system" },
  application: { "zh-Hans": "应用", en: "Application" }, agent: { "zh-Hans": "Agent", en: "Agent" },
  tool: { "zh-Hans": "工具", en: "Tool" },
  "developer-tool": { "zh-Hans": "开发者工具", en: "Developer tool" }, platform: { "zh-Hans": "平台", en: "Platform" },
  "api-service": { "zh-Hans": "API 服务", en: "API service" }, hardware: { "zh-Hans": "硬件", en: "Hardware" },
  framework: { "zh-Hans": "框架", en: "Framework" },
} as const;
const statusLabels = {
  announced: { "zh-Hans": "已公布", en: "Announced" }, preview: { "zh-Hans": "预览", en: "Preview" },
  available: { "zh-Hans": "可用", en: "Available" }, deprecated: { "zh-Hans": "已弃用", en: "Deprecated" },
  discontinued: { "zh-Hans": "已停止", en: "Discontinued" },
} as const;

const copy = locale === "en"
  ? {
      back: entityType === "brand" ? "All brands" : "All products", library: "Wiki",
      aliases: "Also known as", facts: "At a glance", type: "Type", childBrands: "Brands", products: "Products", episodes: "Episodes",
      brand: "Brand", parentBrand: "Parent brand", status: "Status", released: "Released", verified: "Last verified", official: "Official links",
      website: "Website", documentation: "Documentation", repository: "Repository", brandConnections: "Brands and products", connections: "Related products",
      verification: "Information last verified",
    }
  : {
      back: entityType === "brand" ? "全部品牌" : "全部产品", library: "AI 资料库",
      aliases: "别名", facts: "基本信息", type: "类型", childBrands: "旗下品牌", products: "旗下产品", episodes: "相关节目",
      brand: "所属品牌", parentBrand: "所属品牌", status: "状态", released: "发布日期", verified: "最近核验", official: "官方链接",
      website: "官方网站", documentation: "开发文档", repository: "代码仓库", brandConnections: "旗下品牌与产品", connections: "相关产品",
      verification: "资料最近核验于",
    };

let entity;
let kind;
let official;
let verified;
let facts: Array<{ label: string; value: string; href?: string }> = [];
let connections: Array<{ name: string; kind: string; href: string }> = [];
let episodes;
let schema;

if (entityType === "brand") {
  const profile = await getBrandProfile(entityId);
  entity = profile.brand;
  kind = brandKind[profile.brand.data.kind][locale];
  official = profile.brand.data.official;
  verified = profile.brand.data.lastVerifiedAt;
  episodes = profile.episodes;
  facts = [
    { label: copy.type, value: kind },
    ...(profile.parentBrand ? [{ label: copy.parentBrand, value: profile.parentBrand.data.name[locale], href: `${prefix}/wiki/brands/${profile.parentBrand.id}` }] : []),
    { label: copy.childBrands, value: String(profile.childBrands.length) },
    { label: copy.products, value: String(profile.products.length) },
    { label: copy.episodes, value: String(profile.episodes.length) },
  ];
  connections = [
    ...profile.childBrands.map((brand) => ({
      name: brand.data.name[locale], kind: brandKind[brand.data.kind][locale], href: `${prefix}/wiki/brands/${brand.id}`,
    })),
    ...profile.products.map((product) => ({
      name: product.data.name[locale], kind: productKind[product.data.kind][locale], href: `${prefix}/wiki/products/${product.id}`,
    })),
  ];
  schema = {
    "@context": "https://schema.org",
    "@type": ["ai-brand", "hardware-brand", "internet-software-brand", "media-community-brand", "other-brand"].includes(profile.brand.data.kind) ? "Organization" : "Brand",
    name: profile.brand.data.name[locale], alternateName: profile.brand.data.aliases,
    description: profile.brand.data.summary[locale], url: official?.website,
  };
} else {
  const profile = await getProductProfile(entityId);
  entity = profile.product;
  kind = productKind[profile.product.data.kind][locale];
  official = profile.product.data.official;
  verified = profile.product.data.lastVerifiedAt;
  episodes = profile.episodes;
  facts = [
    { label: copy.type, value: kind },
    ...(profile.brand ? [{ label: copy.brand, value: profile.brand.data.name[locale], href: `${prefix}/wiki/brands/${profile.brand.id}` }] : []),
    ...(profile.product.data.status ? [{ label: copy.status, value: statusLabels[profile.product.data.status][locale] }] : []),
    ...(profile.product.data.releasedAt ? [{
      label: copy.released,
      value: new Intl.DateTimeFormat(locale === "en" ? "en-US" : "zh-Hans", { dateStyle: "long", timeZone: "UTC" })
        .format(new Date(`${profile.product.data.releasedAt}T12:00:00Z`)),
    }] : []),
  ];
  connections = [
    ...(profile.parent ? [{ name: profile.parent.data.name[locale], kind: productKind[profile.parent.data.kind][locale], href: `${prefix}/wiki/products/${profile.parent.id}` }] : []),
    ...profile.children.map((product) => ({ name: product.data.name[locale], kind: productKind[product.data.kind][locale], href: `${prefix}/wiki/products/${product.id}` })),
  ];
  schema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `${profile.product.data.name[locale]}｜${locale === "en" ? "Product profile" : "产品资料"}｜Next Token`,
    description: profile.product.data.summary[locale],
    url: new URL(`${prefix}/wiki/products/${entityId}`, Astro.site).toString(),
    inLanguage: locale,
    about: {
      "@type": "Thing",
      name: profile.product.data.name[locale],
      alternateName: displayAliases(profile.product.data.name, profile.product.data.aliases),
      description: profile.product.data.summary[locale],
      sameAs: official?.website,
    },
  };
}

const officialLinks = official ? [
  official.website && { label: copy.website, href: official.website },
  official.documentation && { label: copy.documentation, href: official.documentation },
  official.repository && { label: copy.repository, href: official.repository },
].filter(Boolean) as Array<{ label: string; href: string }> : [];
const verifiedValue = verified
  ? new Intl.DateTimeFormat(locale === "en" ? "en-US" : "zh-Hans", {
      year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
    }).format(new Date(`${verified}T12:00:00Z`))
  : undefined;
const posterWord = entityType === "brand" ? "BRAND" : "PRODUCT";
const visibleAliases = entityType === "product"
  ? displayAliases(entity.data.name, entity.data.aliases)
  : entity.data.aliases;
const articleEntityLabel = entityType === "product"
  ? (locale === "en" ? "Product" : "产品")
  : (locale === "en" ? "Brand" : "品牌");
const connectionsLabel = entityType === "brand" ? copy.brandConnections : copy.connections;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

<main id="main" class:list={["entity-detail-page", { "has-wiki-article": !!article }]}>
  {article ? <WikiDetailHeader backHref={`${prefix}/wiki/${entityType === "brand" ? "brands" : "products"}`} backLabel={copy.back}
    name={entity.data.name[locale]} summary={entity.data.summary[locale]} aliases={visibleAliases} aliasesLabel={copy.aliases}>
    <WikiIdentityCard class="entity-article-poster" label={articleEntityLabel} title={kind} />
  </WikiDetailHeader> : <>
  <div class="entity-detail-back shell">
    <a href={`${prefix}/wiki/${entityType === "brand" ? "brands" : "products"}`}><span aria-hidden="true">←</span>{copy.back}</a>
  </div>

  <section class="entity-detail-hero shell" aria-labelledby="entity-name">
    {!article && <div class="entity-detail-poster">
      <p class="eyebrow">Next Token / {copy.library}</p>
      <strong aria-hidden="true">{posterWord}</strong>
      <span><small>{copy.type}</small>{kind}</span>
    </div>}
    <div class="entity-detail-copy">
      <h1 id="entity-name">{entity.data.name[locale]}</h1>
      <p class="entity-detail-summary">{entity.data.summary[locale]}</p>
      {visibleAliases.length > 0 && (article
        ? <details class="entity-article-aliases"><summary>{copy.aliases} <span>{visibleAliases.length}</span></summary><p>{visibleAliases.join(" · ")}</p></details>
        : <p class="entity-detail-aliases"><span>{copy.aliases}</span>{visibleAliases.join(" · ")}</p>)}
    </div>
  </section>
  </>}

  <WikiArticle entityType={entityType} entityId={entityId} name={entity.data.name[locale]} locale={locale} lastVerifiedAt={verified} />

  <section class:list={["entity-detail-facts shell", { "wiki-support-section": !!article }]} aria-labelledby="entity-facts-title">
    <div>
      {!article && <p class="section-kicker">01 / {copy.facts}</p>}
      <h2 class={article ? "wiki-support-heading" : "heading-section-content"} id="entity-facts-title">{copy.facts}</h2>
    </div>
    <dl>
      {facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.href ? <a class="wiki-support-link" href={fact.href}>{fact.value} →</a> : fact.value}</dd></div>)}
    </dl>
  </section>

  {(connections.length > 0 || officialLinks.length > 0 || verifiedValue) && (
    <section class:list={["entity-detail-links shell", { "wiki-support-section": !!article }]} aria-labelledby="entity-links-title">
      <div>
        {!article && <p class="section-kicker">02 / {connections.length > 0 ? connectionsLabel : copy.official}</p>}
        <h2 class={article ? "wiki-support-heading" : "heading-section-content"} id="entity-links-title">{connections.length > 0 ? connectionsLabel : copy.official}</h2>
      </div>
      <div class="entity-detail-links-content">
        {connections.length > 0 && <div class="entity-connection-list">
          {connections.map((item) => <a class="entity-connection wiki-support-link" href={item.href}><span>{item.kind}</span><strong>{item.name}</strong><b aria-hidden="true">→</b></a>)}
        </div>}
        {officialLinks.length > 0 && <div class="entity-official-block">
          <p>{copy.official}</p>
          <div class="entity-official-links" aria-label={copy.official}>
            {officialLinks.map((item) => <a class="wiki-support-link" href={item.href} target="_blank" rel="noopener noreferrer"><span>{item.label}</span><b aria-hidden="true">↗</b></a>)}
          </div>
        </div>}
        {entity.data.sources.length > 0 && <div class="entity-official-block">
          <p>{locale === "en" ? "Sources" : "资料来源"}</p>
          <div class="entity-official-links">
            {entity.data.sources.map(source => <a class="wiki-support-link" href={source.href} target="_blank" rel="noopener noreferrer"><span>{source.label[locale]}</span><b aria-hidden="true">↗</b></a>)}
          </div>
        </div>}
        {verifiedValue && !article && <p class="entity-verification">{copy.verification} {verifiedValue}</p>}
      </div>
    </section>
  )}

  <EntityPeopleRelations entityType={entityType} entityId={entityId} locale={locale} compact={!!article} />
  <RelatedEpisodes episodes={episodes} locale={locale} compact={!!article} />
</main>

<style>
  .entity-detail-back { padding-block: 1.5rem; border-bottom: 1px solid var(--ink); }
  .entity-detail-back a { display: inline-flex; align-items: center; gap: .75rem; font-weight: 750; }
  .entity-detail-hero { display: grid; grid-template-columns: minmax(18rem, .58fr) minmax(0, 1.42fr); gap: clamp(3rem, 7vw, 8rem); min-height: clamp(560px, calc(100svh - 126px), 680px); align-items: stretch; }
  .entity-detail-poster { display: flex; min-height: 100%; flex-direction: column; justify-content: space-between; padding: clamp(2rem, 4vw, 3.5rem); color: var(--paper); background: var(--ink); overflow: hidden; }
  .entity-detail-poster .eyebrow { gap: .6rem; margin: 0; font-size: .68rem; letter-spacing: .1em; white-space: nowrap; }
  .entity-detail-poster .eyebrow::before { width: 1.75rem; flex: 0 0 auto; }
  .entity-detail-poster strong { align-self: center; color: var(--signal); font-family: var(--display); font-size: clamp(4.2rem, 8vh, 6.4rem); line-height: .82; letter-spacing: var(--display-tracking); writing-mode: vertical-rl; transform: rotate(180deg); }
  .entity-detail-poster > span { font-family: var(--display); font-size: clamp(1.65rem, 2.5vw, 2.7rem); line-height: 1.1; }
  .entity-detail-poster small { display: block; margin-bottom: .55rem; color: rgba(255,255,255,.58); font-family: var(--sans); font-size: .72rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .entity-detail-copy { align-self: center; padding-block: clamp(3rem, 7vw, 7rem); }
  .entity-detail-copy h1 { max-width: 62rem; margin: 0 0 2.5rem; font-size: clamp(4rem, 8vw, 8rem); line-height: 1; overflow-wrap: anywhere; }
  .entity-detail-summary { max-width: 54rem; margin: 0; color: var(--muted); font-size: clamp(1.3rem, 2.3vw, 2rem); line-height: 1.6; }
  .entity-detail-aliases { margin: 2.5rem 0 0; color: var(--muted); }
  .entity-detail-aliases span { display: block; margin-bottom: .35rem; color: var(--ink); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .entity-detail-facts, .entity-detail-links { display: grid; grid-template-columns: minmax(16rem, .65fr) minmax(0, 1.35fr); gap: clamp(3rem, 8vw, 9rem); padding-block: clamp(5rem, 9vw, 9rem); border-top: 1px solid var(--ink); }
  .entity-detail-facts h2, .entity-detail-links h2 { margin: 1.5rem 0 0; }
  .entity-detail-facts dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); margin: 0; border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
  .entity-detail-facts dl > div { min-height: 150px; padding: 1.5rem; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .entity-detail-facts dt { margin-bottom: 2.5rem; color: var(--muted); font-size: .75rem; font-weight: 700; }
  .entity-detail-facts dd { margin: 0; font-family: var(--display); font-size: clamp(1.3rem, 2vw, 2rem); line-height: 1.15; }
  .entity-detail-links-content { min-width: 0; }
  .entity-connection-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
  .entity-connection { display: grid; min-height: 160px; grid-template-columns: minmax(0, 1fr) 2rem; gap: 1rem; align-content: space-between; padding: 1.5rem; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .entity-connection span { color: var(--muted); font-size: .78rem; }
  .entity-connection strong { align-self: end; font-size: clamp(1.3rem, 2.3vw, 2rem); }
  .entity-connection b { grid-column: 2; grid-row: 1 / span 2; align-self: end; font-size: 1.5rem; text-align: right; }
  .entity-connection:hover { color: var(--paper); background: var(--ink); }
  .entity-connection:hover span { color: rgba(255,255,255,.62); }
  .entity-official-block { margin-top: 2.5rem; }
  .entity-official-block > p { margin: 0 0 .8rem; color: var(--muted); font-size: .75rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .entity-official-links { display: flex; flex-wrap: wrap; gap: .75rem; }
  .entity-official-links a { display: inline-flex; gap: 1.5rem; padding: .9rem 1.15rem; border: 1px solid var(--ink); font-weight: 750; }
  .entity-official-links a:hover { color: var(--paper); background: var(--ink); }
  .entity-verification { margin: 2rem 0 0; padding-top: 1rem; border-top: 1px solid rgba(17,17,17,.25); color: var(--muted); font-size: .75rem; line-height: 1.5; }
  .entity-article-aliases { margin-top: 1rem; color: var(--muted); font-size: .85rem; line-height: 1.7; }
  .entity-article-aliases summary { width: fit-content; cursor: pointer; }
  .entity-article-aliases summary span { margin-left: .35rem; font-size: .75rem; }
  .entity-article-aliases p { margin: .5rem 0 0; }
  .has-wiki-article .entity-detail-facts dl { border: 0; gap: .5rem 2rem; }
  .has-wiki-article .entity-detail-facts dl > div { min-height: 0; padding: 0; border: 0; }
  .has-wiki-article .entity-detail-facts dt { margin-bottom: .35rem; }
  .has-wiki-article .entity-detail-facts dd { font-family: var(--sans); font-size: 1rem; line-height: 1.5; }
  .has-wiki-article .entity-connection-list { border: 0; gap: .5rem 1.5rem; }
  .has-wiki-article .entity-connection { min-height: 0; padding: .75rem 0; gap: .35rem; border: 0; }
  .has-wiki-article .entity-connection strong { font-size: 1.1rem; }
  .has-wiki-article .entity-official-block { margin-top: 1rem; }
  .has-wiki-article .entity-official-block:first-child { margin-top: 0; }
  .has-wiki-article .entity-official-links { gap: .5rem 1.25rem; }
  .has-wiki-article .entity-official-links a { padding: .25rem 0; border: 0; font-size: .9rem; gap: .5rem; }
  .has-wiki-article .entity-verification { margin-top: 1rem; padding-top: .75rem; }
  @media (max-width: 760px) {
    .has-wiki-article .entity-detail-facts dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .entity-detail-hero { grid-template-columns: 1fr; min-height: 0; gap: 3rem; }
    .entity-detail-poster { min-height: 220px; }
    .entity-detail-poster .eyebrow { white-space: normal; }
    .entity-detail-poster strong { align-self: flex-start; font-size: clamp(3.6rem, 18vw, 5rem); writing-mode: horizontal-tb; transform: none; }
    .entity-detail-copy h1 { font-size: clamp(3.4rem, 18vw, 5.5rem); }
    .entity-detail-facts, .entity-detail-links { grid-template-columns: 1fr; gap: 2.5rem; }
    .entity-detail-facts dl { grid-template-columns: 1fr; }
  }
</style>
