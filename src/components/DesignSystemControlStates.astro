---
import type { Locale } from '../data/types';
import ColorUse from './DesignSystemColorUse.astro';
interface Props { locale: Locale }
const {locale}=Astro.props;
const t=(zh:string,en:string)=>locale==='en'?en:zh;
---
<div class="ds-state-controls" data-state-controls data-copied={t('链接已复制','Link copied')} data-fallback={t('复制下方链接','Copy the link below')}>
 <h3>{t('开关与展开','Switches and disclosure')}</h3>
 <p>{t('开关直接改变一个设置，并用文字和位置表达当前状态。展开控件显示或隐藏同一组内容，不改变页面位置。','Switches change one setting, with text and position indicating state. Disclosure controls show or hide grouped content without navigating away.')}</p>
 <button type="button" class="control-switch" role="switch" aria-checked="false" data-highlight-switch><span class="control-switch-track" aria-hidden="true"></span>{t('强调分类链接','Emphasize category links')}</button>
 <p>{t('关闭轨道：','Inactive track: ')}<ColorUse locale={locale} token="--switch-track" />{t('；开启轨道：','; active track: ')}<ColorUse locale={locale} token="--signal-text" />{t('。','.')}</p>
 <details class="ds-disclosure"><summary>{t('补充信息','Additional information')}</summary><p>{t('展开状态保留标题、键盘焦点和完整内容。','The expanded state retains the heading, keyboard focus and complete content.')}</p></details>
 <h3>{t('操作反馈','Action feedback')}</h3>
 <p>{t('复制操作在按钮旁反馈成功；剪贴板不可用时提供可选择的只读链接。反馈不只依赖颜色。','Copy actions confirm success beside the button. If clipboard access is unavailable, a selectable read-only link is provided. Feedback does not rely on color alone.')}</p>
 <div class="ds-copy"><button type="button" class="control-button" data-copy-example>{t('复制示例链接','Copy example link')}</button><span role="status" aria-live="polite" data-copy-status></span><input class="control-input" readonly hidden aria-label={t('可复制的链接','Link to copy')} /></div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-state-controls]').forEach(root=>{
  const toggle=root.querySelector<HTMLButtonElement>('[data-highlight-switch]')!;
  toggle.addEventListener('click',()=>{const on=toggle.getAttribute('aria-checked')!=='true';toggle.setAttribute('aria-checked',String(on));document.querySelector('[data-annotation-specimen]')?.setAttribute('data-entity-highlight',String(on));});
  root.querySelector('[data-copy-example]')?.addEventListener('click',async()=>{
   const value=new URL('#reading',location.href).href;const input=root.querySelector<HTMLInputElement>('.ds-copy input')!;const status=root.querySelector('[data-copy-status]')!;
   try {await navigator.clipboard.writeText(value);input.hidden=true;status.textContent=root.dataset.copied!;}
   catch {input.value=value;input.hidden=false;input.focus();input.select();status.textContent=root.dataset.fallback!;}
  });
 });
</script>
<style>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
 .ds-state-controls h3 { font-family: var(--sans); font-size: var(--type-label); margin: 2rem 0 .75rem; }
 .ds-state-controls p { color: var(--muted); font-size: var(--type-ui); line-height: 1.75; }
 .ds-disclosure { border-block: var(--stroke-thin) solid var(--line); margin-top: 1rem; padding-block: .75rem; font-size: var(--type-ui); }
 .ds-disclosure summary { cursor: pointer; } .ds-disclosure p { margin-block: 1rem 0; }
 .ds-copy { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; font-size: var(--type-ui); } .ds-copy input { width: 100%; }
}
</style>
