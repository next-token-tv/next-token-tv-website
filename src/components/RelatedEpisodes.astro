---
import { isReleasePreview } from "../data/episode-visibility";
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../data/types";

interface Props {
  episodes: CollectionEntry<"episodes">[];
  locale: Locale;
  compact?: boolean;
  contained?: boolean;
  chapterLinks?: Array<{ episodeId: string; title: string; href: string }>;
}

const { episodes, locale, compact = false, contained = false, chapterLinks = [] } = Astro.props;
const prefix = locale === "en" ? "/en" : "";
const copy = locale === "en"
  ? { kicker: "Related episodes", title: "Mentioned on Next Token", published: "Now live", announced: "Recording preview" }
  : { kicker: "相关节目", title: "在 Next Token 中出现", published: "现已上线", announced: "录制预告" };
---

{episodes.length > 0 && (
  <section class:list={["entity-related-episodes", { shell: !contained, "is-compact": compact, "wiki-support-section": compact }]} aria-labelledby="related-episodes-title">
    <div>
      {!compact && <p class="section-kicker">03 / {copy.kicker}</p>}
      <h2 class={compact ? "wiki-support-heading" : "heading-section-content"} id="related-episodes-title">{copy.title}</h2>
    </div>
    <div class="entity-related-episode-list">
      {episodes.map((episode) => (
        <div class="related-episode-row">
        <a class="episode-link wiki-support-link" href={`${prefix}/weekly/${episode.data.number}`}>
          <strong>#{episode.data.number}</strong>
          <span>{isReleasePreview(episode.data, import.meta.env.DEV) ? (locale === "en" ? "Episode" : "节目") : episode.data.status === "published" ? copy.published : episode.data.phase === "post-production" ? (locale === "en" ? "In production" : "制作中") : copy.announced}</span>
          <p>{episode.data.title[locale]}</p>
          <b aria-hidden="true">→</b>
        </a>
        {chapterLinks.some(chapter => chapter.episodeId === episode.id) && <div class="episode-chapters">
          {chapterLinks.filter(chapter => chapter.episodeId === episode.id).map(chapter => <a class="wiki-support-link" href={chapter.href}>{locale === "en" ? "Transcript" : "文字稿"} · {chapter.title} ↗</a>)}
        </div>}
        </div>
      ))}
    </div>
  </section>
)}

<style>
@import "../styles/components/related-episodes.css";
</style>
