---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../data/types";

interface Props {
  episodes: CollectionEntry<"episodes">[];
  locale: Locale;
  compact?: boolean;
  contained?: boolean;
  chapterLinks?: Array<{ episodeId: string; title: string; href: string }>;
}

const { episodes, locale, compact = false, contained = false, chapterLinks = [] } = Astro.props;
const prefix = locale === "en" ? "/en" : "";
const copy = locale === "en"
  ? { kicker: "Related episodes", title: "Mentioned on Next Token", published: "Now live", announced: "Recording preview" }
  : { kicker: "相关节目", title: "在 Next Token 中出现", published: "现已上线", announced: "录制预告" };
---

{episodes.length > 0 && (
  <section class:list={["entity-related-episodes", { shell: !contained, "is-compact": compact, "wiki-support-section": compact }]} aria-labelledby="related-episodes-title">
    <div>
      {!compact && <p class="section-kicker">03 / {copy.kicker}</p>}
      <h2 class={compact ? "wiki-support-heading" : "heading-section-content"} id="related-episodes-title">{copy.title}</h2>
    </div>
    <div class="entity-related-episode-list">
      {episodes.map((episode) => (
        <div class="related-episode-row">
        <a class="episode-link wiki-support-link" href={`${prefix}/weekly/${episode.data.number}`}>
          <strong>#{episode.data.number}</strong>
          <span>{episode.data.status === "published" ? copy.published : episode.data.phase === "post-production" ? (locale === "en" ? "In production" : "制作中") : copy.announced}</span>
          <p>{episode.data.title[locale]}</p>
          <b aria-hidden="true">→</b>
        </a>
        {chapterLinks.some(chapter => chapter.episodeId === episode.id) && <div class="episode-chapters">
          {chapterLinks.filter(chapter => chapter.episodeId === episode.id).map(chapter => <a class="wiki-support-link" href={chapter.href}>{locale === "en" ? "Transcript" : "文字稿"} · {chapter.title} ↗</a>)}
        </div>}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .entity-related-episodes { display: grid; grid-template-columns: minmax(16rem, .65fr) minmax(0, 1.35fr); gap: clamp(3rem, 8vw, 9rem); padding-block: clamp(5rem, 9vw, 9rem); border-top: 1px solid var(--ink); }
  .entity-related-episodes h2 { max-width: 34rem; margin: 1.5rem 0 0; }
  .entity-related-episode-list { border-top: 1px solid var(--ink); }
  .entity-related-episode-list .episode-link { display: grid; grid-template-columns: 6rem 8rem minmax(0, 1fr) 2rem; gap: 1rem; align-items: center; padding: 1.5rem 0; border-bottom: 1px solid var(--ink); }
  .entity-related-episode-list strong { color: var(--signal); font-family: var(--display); font-size: 1.6rem; }
  .entity-related-episode-list span { color: var(--muted); font-size: .78rem; }
  .entity-related-episode-list p { margin: 0; font-weight: 750; line-height: 1.45; }
  .entity-related-episode-list b { font-size: 1.5rem; text-align: right; }
  .episode-chapters { display: grid; gap: .5rem; padding: .75rem 0; font-size: .85rem; color: var(--muted); overflow-wrap: anywhere; }
  .episode-chapters a:hover { color: var(--signal); }
  .is-compact { padding-block: 1.5rem; gap: 1.5rem 3rem; grid-template-columns: minmax(10rem, .55fr) minmax(0, 1.45fr); border-color: var(--line); }
  .is-compact .wiki-support-heading { margin: 0; }
  .is-compact .entity-related-episode-list { border-top: 0; }
  .is-compact .entity-related-episode-list .episode-link { padding: .75rem 0; grid-template-columns: 3.5rem 5rem minmax(0, 1fr) 1rem; gap: .75rem; }
  .is-compact .entity-related-episode-list strong { font-size: 1.1rem; }
  @media (max-width: 760px) {
    .entity-related-episodes.is-compact { grid-template-columns: 1fr; gap: 1rem; }
    .is-compact .entity-related-episode-list .episode-link { grid-template-columns: 3.5rem minmax(0, 1fr) 1rem; }
    .entity-related-episodes { grid-template-columns: 1fr; gap: 2.5rem; }
    .entity-related-episode-list .episode-link { grid-template-columns: 4.5rem minmax(0, 1fr) 2rem; }
    .entity-related-episode-list span { grid-column: 2; }
    .entity-related-episode-list p { grid-column: 2; }
    .entity-related-episode-list b { grid-column: 3; grid-row: 1 / span 3; }
  }
</style>
