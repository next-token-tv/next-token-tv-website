---
import type { Locale } from "../data/site";
import type { Partner } from "../data/partners";
import { partnerPath } from "../data/partners";

interface Props {
  partner: Partner;
  locale: Locale;
}

const { partner, locale } = Astro.props;
const path = partnerPath(partner, locale);
const copy = locale === "zh-Hans"
  ? { venues: `${partner.venues.length} 个场地`, detail: "伙伴详情", logo: `${partner.name}标志` }
  : { venues: `${partner.venues.length} venue${partner.venues.length === 1 ? "" : "s"}`, detail: "Partner profile", logo: `${partner.englishName} logo` };
---

<article class="partner-row">
  <a href={path} aria-label={`${copy.detail}：${partner.name}`} class:list={["partner-row-logo", "partner-row-link", { "partner-logo-dark": partner.logoDarkBackground }]}>
    <img src={partner.logo} width="142" height="101" alt={copy.logo} loading="lazy" />
  </a>
  <a class="partner-row-identity partner-row-link" href={path}>
    <p class="partner-role">{partner.role[locale]}</p>
    <h2>{partner.name}</h2>
    <p class="partner-english-name">{partner.englishName}</p>
  </a>
  <a class="partner-row-summary partner-row-link" href={path}>{partner.summary[locale]}</a>
  <div class="partner-row-location">
    <strong>{copy.venues}</strong>
    <ul>
      {partner.venues.map((venue) => (
        <li>
          <span>{venue.name[locale]}</span>
          <small>{venue.location.label[locale]}</small>
        </li>
      ))}
    </ul>
  </div>
  <a class="partner-row-action" href={path} aria-label={`${copy.detail}：${partner.name}`}>
    <span>{copy.detail}</span><span aria-hidden="true">→</span>
  </a>
</article>
