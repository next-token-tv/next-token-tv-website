---
import PlatformBrand from "./PlatformBrand.astro";

interface Props {
  platforms: { platform: string; label: string; href?: string; action?: string; accountName?: string; qr?: { image: string; width: number; height: number } }[];
  idPrefix?: string;
  compact?: boolean;
  qrLabel?: string;
  qrHint?: string;
  label?: string;
  available?: string;
  comingSoon: string;
  reveal?: boolean;
}

const { platforms, label, available, comingSoon, reveal = false, qrLabel = "查看二维码", qrHint = "用微信扫一扫，或长按图片识别关注", idPrefix = "follow", compact = false } = Astro.props;
---

<div class:list={["platform-list", { "platform-list-compact": compact }]} aria-label={label} data-reveal={reveal || undefined}>
  {platforms.map((platform, index) => {
    if (platform.qr && !platform.href) return (
      <div class="platform-qr-row">
        <button class:list={["platform-qr-trigger", compact ? "episode-listen episode-platform" : "platform is-live"]} type="button" aria-expanded="false" aria-controls={`${idPrefix}-qr-${platform.platform}`}>
          <span class="index">{String(index + 1).padStart(2, "0")}</span>
          <strong><PlatformBrand platform={platform.platform} name={platform.label} /></strong>
          <span class="coming">{platform.action ?? qrLabel}</span>
        </button>
        <div class="platform-qr" id={`${idPrefix}-qr-${platform.platform}`} popover="manual" role="region" aria-label={`${platform.label} · ${platform.accountName}`}>
          <p class="platform-qr-name">{platform.accountName}</p>
          <img src={platform.qr.image} width={platform.qr.width} height={platform.qr.height} alt={`${platform.label} · ${platform.accountName}`} />
          <p class="platform-qr-hint">{qrHint}</p>
        </div>
      </div>
    );
    const Tag = platform.href ? "a" : "div";
    return (
      <Tag class:list={["platform", { "is-live": !!platform.href }]}
        data-listen-platform={platform.href ? platform.platform : undefined}
        href={platform.href} target={platform.href ? "_blank" : undefined}
        rel={platform.href ? "noopener noreferrer" : undefined}>
        <span class="index">{String(index + 1).padStart(2, "0")}</span>
        <strong><PlatformBrand platform={platform.platform} name={platform.label} />
          {platform.accountName && <span class="platform-account-name">{platform.accountName}</span>}
        </strong>
        <span class="coming">
          {platform.href ? platform.action ?? available : platform.action ?? comingSoon}
          {platform.href && <> <span aria-hidden="true">↗</span></>}
        </span>

      </Tag>
    );
  })}
</div>
<script>
  document.querySelectorAll<HTMLElement>(".platform-qr-row").forEach(row => {
    const button = row.querySelector<HTMLButtonElement>("button")!;
    const panel = row.querySelector<HTMLElement>(".platform-qr")!;
    // Keep QR disclosure in-page even when the Popover API is unavailable.
    if (typeof panel.showPopover !== "function") {
      panel.hidden = true;
      panel.classList.add("platform-qr-fallback");
      const setOpen = (open: boolean) => {
        panel.hidden = !open;
        panel.style.display = open ? "block" : "none";
        button.setAttribute("aria-expanded", String(open));
      };
      button.addEventListener("click", () => setOpen(panel.hidden));
      document.addEventListener("keydown", event => { if (event.key === "Escape") setOpen(false); });
      document.addEventListener("pointerdown", event => { if (!row.contains(event.target as Node)) setOpen(false); });
      return;
    }
    let timer: ReturnType<typeof setTimeout>;
    let pinned = false;
    const close = () => { clearTimeout(timer); panel.hidePopover(); button.setAttribute("aria-expanded", "false"); pinned = false; };
    const position = () => {
      const rect = button.getBoundingClientRect();
      const gap = 8, margin = 12;
      const width = panel.offsetWidth, height = panel.offsetHeight;
      panel.style.left = `${Math.max(margin, Math.min(rect.right - width, innerWidth - width - margin))}px`;
      const below = rect.bottom + gap;
      panel.style.top = `${Math.max(margin, Math.min(below + height <= innerHeight - margin ? below : rect.top - height - gap, innerHeight - height - margin))}px`;
    };
    const open = () => {
      clearTimeout(timer);
      document.querySelectorAll<HTMLElement>(".platform-qr:popover-open").forEach(other => {
        if (other !== panel) { other.hidePopover(); other.parentElement?.querySelector("button")?.setAttribute("aria-expanded", "false"); }
      });
      panel.showPopover(); button.setAttribute("aria-expanded", "true"); position();
    };
    panel.addEventListener("toggle", () => { if (!panel.matches(":popover-open")) { pinned = false; button.setAttribute("aria-expanded", "false"); } });
    button.addEventListener("pointerenter", event => { if (event.pointerType === "mouse") open(); });
    button.addEventListener("pointerleave", () => { if (!pinned) timer = setTimeout(close, 180); });
    panel.addEventListener("pointerenter", () => clearTimeout(timer));
    panel.addEventListener("pointerleave", () => { if (!pinned) timer = setTimeout(close, 180); });
    button.addEventListener("focus", () => { if (button.matches(":focus-visible")) open(); });
    document.addEventListener("focusin", event => { if (!row.contains(event.target as Node)) close(); });
    button.addEventListener("click", () => { if (pinned) close(); else { open(); pinned = true; } });
    document.addEventListener("pointerdown", event => { if (!row.contains(event.target as Node)) close(); });
    document.addEventListener("keydown", event => { if (event.key === "Escape") close(); });
    window.addEventListener("resize", close);
    window.addEventListener("scroll", () => { if (panel.matches(":popover-open")) position(); }, { passive: true });
  });
</script>
<style>
@import "../styles/components/platform-list.css";
</style>
