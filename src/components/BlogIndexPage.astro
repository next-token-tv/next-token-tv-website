---
import type { Locale } from "../data/types";
import BlogEditorial from "../components/BlogEditorial.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteContent } from "../data/site";
import { getBlogPosts } from "../data/blog";
import { getEpisodesForShow } from "../data/catalog";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const prefix = locale === "en" ? "/en" : "";
const copy = (zh: string, en: string) => locale === "en" ? en : zh;
const content = await getSiteContent(locale);
const posts = await getBlogPosts(locale);
const episodes = (await getEpisodesForShow("next-token-weekly")).filter(episode => posts.some(post => post.data.episodes.includes(episode.id))).reverse();
---
<BaseLayout content={content} pageTitle={copy("博客｜Next Token 词元之外", "Blog | Next Token 词元之外")} description={copy("从 Next Token 对谈出发，深入阅读 AI 产品、技术与真实使用体验。", "Long-form articles on AI products, technology, and first-hand experience, expanding on Next Token conversations.")} canonicalPath={`${prefix}/blog`} alternatePath={locale === "en" ? "/blog" : "/en/blog"}>
  <main id="main" class="blog-page shell">
    <header class="blog-intro">
      <p class="section-kicker">{copy("NEXT TOKEN / 博客", "NEXT TOKEN / BLOG")}</p>
      <h1 class="type-title">{copy("从对谈出发，", "From conversations, ")}<br />{copy("把一个问题聊透。", " one question at a time.")}</h1>
      <p>{copy("AI 产品、技术与真实使用体验。值得展开的话题，值得留下的细节。", "AI products, technology, and first-hand experience. Topics worth expanding, details worth keeping.")}</p>
      <a class="blog-read" href={`${prefix}/blog/episodes`}>{copy("按期浏览博客", "Browse by episode")} <span aria-hidden="true">→</span></a>
      <a class="blog-read blog-feed" href={`${prefix}/blog/rss.xml`} type="application/rss+xml">{copy("RSS 订阅", "Subscribe via RSS")} <span aria-hidden="true">↗</span></a>
    </header>
    <form class="blog-filters" data-count-suffix={copy(" 篇文章", " articles")} hidden role="search" aria-label={copy("筛选博客", "Filter blog posts")}>
      <div><label for="blog-query">{copy("搜索主题", "Search topics")}</label><input class="control-input" id="blog-query" type="search" name="q" placeholder={copy("标题或摘要中的关键词", "Keywords from titles or summaries")} /></div>
      <div><label for="blog-episode">{copy("节目期数", "Episode")}</label><select id="blog-episode" name="episode"><option value="">{copy("全部期数", "All episodes")}</option>{episodes.map(episode => <option value={episode.data.number}>{copy(`第 ${episode.data.number} 期`, `Episode ${episode.data.number}`)}</option>)}</select></div>
      <button class="control-button" type="reset">{copy("清除筛选", "Clear filters")}</button>
      <p class="filter-count" role="status" aria-live="polite">{posts.length}{copy(" 篇文章", " articles")}</p>
    </form>
    <p class="blog-no-results" hidden>{copy("没有找到相关文章，试试其他关键词或期数。", "No articles found. Try other keywords or episodes.")}</p>
    <section aria-label={copy("博客文章", "Blog articles")} class="blog-list">
      {posts.length ? posts.map(post => <article class="blog-row" data-search={`${post.data.title} ${post.data.description}`} data-episodes={post.data.episodes.join(" ")}>
        <div class="blog-meta"><time datetime={post.data.publishedAt ?? post.data.updatedAt}>{post.data.publishedAt ?? post.data.updatedAt}</time>{post.data.status === "draft" && <span>{copy("审阅稿", "Under review")}</span>}</div>
        <div><h2><a href={`${prefix}/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="blog-read" href={`${prefix}/blog/${post.id}`}>{copy("阅读全文", "Read more")} <span aria-hidden="true">→</span></a></div>
      </article>) : <p class="blog-empty">{copy("文章正在准备中。先从 ", "Articles are on the way. Start with the ")}<a href={`${prefix}/weekly`}>{copy("Weekly 对谈", "Weekly conversations")}</a>{copy(" 开始阅读。", ".")}</p>}
    </section>
    <BlogEditorial locale={locale} />
  </main>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>(".blog-filters");
  const query = document.querySelector<HTMLInputElement>("#blog-query");
  const episode = document.querySelector<HTMLSelectElement>("#blog-episode");
  const rows = [...document.querySelectorAll<HTMLElement>(".blog-row")];
  if (form && query && episode) {
    const normalize = (value: string) => value.normalize("NFKC").toLocaleLowerCase();
    const apply = (updateUrl: boolean) => {
      const terms = normalize(query.value).trim().split(/\s+/u).filter(Boolean);
      let count = 0;
      for (const row of rows) {
        const matches = terms.every(term => normalize(row.dataset.search ?? "").includes(term)) &&
          (!episode.value || (row.dataset.episodes ?? "").split(" ").includes(`next-token-weekly--${episode.value}`));
        row.hidden = !matches;
        if (matches) count++;
      }
      form.querySelector<HTMLElement>(".filter-count")!.textContent = `${count}${form.dataset.countSuffix}`;
      document.querySelector<HTMLElement>(".blog-no-results")!.hidden = count > 0;
      if (updateUrl) {
        const url = new URL(location.href);
        for (const [key, value] of [["q", query.value.trim()], ["episode", episode.value]] as const) {
          if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
        }
        history.replaceState(null, "", url);
      }
    };
    const restore = () => {
      const params = new URLSearchParams(location.search);
      query.value = params.get("q") ?? "";
      episode.value = params.get("episode") ?? "";
      apply(false);
    };
    form.hidden = false;
    restore();
    form.addEventListener("submit", event => { event.preventDefault(); apply(true); });
    query.addEventListener("input", () => apply(true));
    episode.addEventListener("change", () => apply(true));
    form.addEventListener("reset", () => { query.value = ""; episode.value = ""; apply(true); });
    window.addEventListener("popstate", restore);
  }
</script>
<style>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
.blog-filters { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; gap: 1rem 1.5rem; align-items: end; margin-bottom: 2rem; }
  .blog-filters label { display: block; margin-bottom: .5rem; font-size: var(--type-ui); font-weight: 700; }
  .blog-filters input, .blog-filters select { width: 100%; min-width: 0; }
  .blog-filters button { cursor: pointer; }
  .filter-count { grid-column: 1 / -1; color: var(--muted); font-size: var(--type-ui); }
  .blog-no-results { padding-block: 2rem; color: var(--muted); }
  .blog-page [hidden] { display: none; }
  @media (max-width: 47.999rem) { .blog-filters { grid-template-columns: minmax(0, 1fr); } }

  .blog-page { padding-block: 3rem 5rem; min-height: 65vh; }
  .blog-intro { padding-bottom: 1.75rem; }
  h1 { margin-block: 1.5rem; }
  .blog-intro > p:not(.section-kicker) { font-size: var(--type-label); color: var(--muted); max-width: 38rem; }
  .blog-row { display: grid; grid-template-columns: minmax(0, 9rem) minmax(0, 46rem); gap: 2rem; padding-block: 1.5rem; border-top: var(--stroke-thin) solid var(--line); }
  .blog-meta { display: flex; flex-direction: column; gap: .75rem; font-size: var(--type-ui); color: var(--muted); }
  h2 { text-wrap: balance; font-size: var(--type-entry); margin: 0 0 1rem; }
  .blog-row p { color: var(--muted); line-height: 1.8; }
  .blog-read { display: inline-flex; gap: 2rem; margin-top: .75rem; font-weight: 600; }
  a:hover { color: var(--signal-text); }
  .blog-feed { margin-inline-start: 2rem; }
  .blog-empty { border-top: var(--stroke-thin) solid var(--line); padding-block: 2rem; }
  .blog-empty a { text-decoration: underline; }
  @media (max-width: 47.999rem) { .blog-row { grid-template-columns: minmax(0, 1fr); gap: 1rem; } .blog-meta { flex-direction: row; align-items: center; flex-wrap: wrap; } }
}
</style>
