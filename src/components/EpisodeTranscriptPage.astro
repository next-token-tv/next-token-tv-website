---
import type { CollectionEntry } from "astro:content";
import { getEpisode, getPeopleByIds } from "../data/catalog";
import type { Locale } from "../data/types";
import TranscriptSegments from "./TranscriptSegments.astro";
import TranscriptReaderTools from "./TranscriptReaderTools.astro";
import TranscriptClipTools from "./TranscriptClipTools.astro";
import { getParagraphAnchorIds } from "../data/transcript-paragraph-anchors";
import { timestampVideoUrl } from "../data/video-timestamps.mjs";

type VideoPlatform = "youtube" | "bilibili";
type Timeline = {
  tracks: {
    videos: Partial<Record<VideoPlatform, string>>;
    times: Record<string, [number, number]>;
    chapterStarts?: Record<string, number>;
  }[];
};
const timelines = import.meta.glob<Timeline>("../content/imported/transcript-timelines/*.json", {
  eager: true,
  import: "default",
});

interface Props {
  transcript: CollectionEntry<"transcriptImports">;
  episodeNumber: string;
  locale: Locale;
  isReviewDraft?: boolean;
  /** The /blog/episodes hub route only exists for published episodes. */
  showBlogLink?: boolean;
  displayTitle?: string;
  titleLines?: string[];
  /** Paragraph anchors from the canonical Chinese transcript; translations must reuse them so deep links match. */
  anchorIds?: string[][][];
}

const { transcript, episodeNumber, locale, isReviewDraft = false, showBlogLink = true, displayTitle = transcript.data.title, titleLines, anchorIds } = Astro.props;
const speakerIds = [...new Set(
  transcript.data.chapters.flatMap(({ turns }) => turns.map(({ speakerId }) => speakerId).filter(Boolean)),
)] as string[];
const people = await getPeopleByIds(speakerIds);
const peopleById = new Map(people.map((person) => [person.id, person]));
const [seriesTitle, ...topicParts] = displayTitle.split("｜");
const topicTitle = topicParts.join("｜");
const episodePath = `${locale === "en" ? "/en" : ""}/weekly/${episodeNumber}`;
const paragraphAnchorIds = anchorIds ?? getParagraphAnchorIds(transcript.data.chapters);
const formatTime = (seconds: number) => {
  const total = Math.floor(seconds);
  const hours = Math.floor(total / 3600);
  const minutes = String(Math.floor(total / 60) % 60).padStart(2, "0");
  const remainder = String(total % 60).padStart(2, "0");
  return hours ? `${hours}:${minutes}:${remainder}` : `${minutes}:${remainder}`;
};
const episode = await getEpisode(transcript.data.episodeId);
const timeline = episode.data.status === "published"
  ? timelines[`../content/imported/transcript-timelines/${episode.id}.json`]
  : undefined;
const videoPlatforms: VideoPlatform[] = locale === "en" ? ["youtube", "bilibili"] : ["bilibili", "youtube"];
const playbackTracks = videoPlatforms.flatMap(platform => {
  const track = timeline?.tracks.find(item => item.videos[platform]);
  const href = track?.videos[platform];
  if (!track || !href) return [];
  const currentHref = episode.data.status === "published"
    ? episode.data.platforms.find(item => item.platform === platform)?.href
    : undefined;
  if (currentHref && timestampVideoUrl(platform, currentHref, 0) !== href) return [];
  return [{ platform, href, times: track.times, chapterStarts: track.chapterStarts, label: platform === "youtube" ? "YouTube" : locale === "en" ? "Bilibili" : "B 站" }];
});
const clipTracks = isReviewDraft ? [] : playbackTracks.filter(track =>
  paragraphAnchorIds.some(chapter => chapter.some(turn => turn.some(id => Object.hasOwn(track.times, id)))),
);
function playbackLink(track: typeof playbackTracks[number], seconds: number | undefined) {
  if (seconds === undefined) return undefined;
  const url = timestampVideoUrl(track.platform, track.href, seconds);
  if (!url) return undefined;
  const time = formatTime(seconds);
  return {
    url, time, label: track.label,
    accessibleLabel: locale === "en" ? `Watch at ${time} on ${track.label}` : `在 ${track.label} 从 ${time} 播放`,
  };
}
function playbackLinks(paragraphId: string | undefined) {
  if (!paragraphId) return [];
  return playbackTracks.map(track => playbackLink(track, track.times[paragraphId]?.[0])).filter(link => link !== undefined);
}
const chapterStarts = transcript.data.chapters.map((chapter, index) => {
  const paragraphs = paragraphAnchorIds[index]?.flat() ?? [];
  const firstParagraph = paragraphs[0];
  if (!firstParagraph) return;
  for (const track of playbackTracks) {
    const seconds = track.chapterStarts?.[chapter.id];
    if (seconds !== undefined) return { id: firstParagraph, time: formatTime(seconds) };
  }
  for (const id of paragraphs) {
    const link = playbackLinks(id)[0];
    if (link) return { id, time: link.time };
  }
});
const copy = locale === "en" ? {
  back: "Back to episode",
  kicker: `Weekly #${episodeNumber} / Transcript`,
  contents: "Contents",
  chapters: "chapters",
  read: "Full transcript",
  markdown: "Markdown format",
  candidate: "speaker attribution pending verification",
  paragraphLink: "Link to this paragraph",
  speakerPage: (name: string) => `Open ${name}'s profile`,
} : {
  back: "返回本期节目",
  kicker: `Weekly #${episodeNumber} / 阅读文字稿`,
  contents: "本期目录",
  chapters: "个章节",
  read: "完整文字稿",
  markdown: "Markdown 格式",
  candidate: "人物署名仍待核对",
  paragraphLink: "引用此段",
  speakerPage: (name: string) => `查看${name}的个人页面`,
};
---

<main id="main" class="transcript-page" data-review-draft={isReviewDraft || undefined}>
  <header class="transcript-hero shell">
    <a class="transcript-back" href={episodePath}>← {copy.back}</a>
    <div class="transcript-hero-grid">
      <div>
        <p class="section-kicker">{copy.kicker}</p>
        <h1 class="heading-reading-title" aria-label={displayTitle}>
          {(titleLines ?? [seriesTitle, topicTitle].filter(Boolean)).map((line) => <span>{line}</span>)}
        </h1>
      </div>
      <div class="transcript-hero-meta">
        <div class="transcript-meta-summary">
          <strong>{copy.read}</strong>
          <span>{String(transcript.data.chapterCount).padStart(2, "0")} {copy.chapters}</span>
        </div>
        <div class="transcript-meta-actions">
          <a class="transcript-format-link" href={`${episodePath}/transcript.md`} type="text/markdown"><span>{copy.markdown}</span><span aria-hidden="true">↗</span></a>
          {!isReviewDraft && showBlogLink && <a class="transcript-format-link" href={`${locale === "en" ? "/en" : ""}/blog/episodes/${episodeNumber}`}><span>{locale === "en" ? "Related blog posts" : "本期相关博客"}</span><span aria-hidden="true">→</span></a>}
        </div>
        {transcript.data.byline && <p>{transcript.data.byline}</p>}
        {transcript.data.notices.map((notice) => <p class="transcript-notice">{notice}</p>)}
      </div>
    </div>
  </header>

  <div class="transcript-layout shell">
    <aside class="transcript-sidebar">
      <TranscriptReaderTools locale={locale} />
      <details class="transcript-toc" open>
        <summary>{copy.contents} · {transcript.data.chapterCount}</summary>
        <ol>
          {transcript.data.chapters.map((chapter, index) => (
            <li>
              <a class="transcript-toc-chapter" href={`#${chapter.id}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {chapter.title}
              </a>
              {chapterStarts[index] && (
                <a class="transcript-toc-time" href={`#${chapterStarts[index].id}`}
                  aria-label={locale === "en" ? `Go to paragraph at ${chapterStarts[index].time}` : `跳到 ${chapterStarts[index].time} 对应段落`}>
                  {chapterStarts[index].time}
                </a>
              )}
            </li>
          ))}
        </ol>
      </details>
    </aside>

    <article class="transcript-body" aria-label={copy.read}>
      {transcript.data.chapters.map((chapter, chapterIndex) => (
        <section class="transcript-chapter" id={chapter.id}>
          <header>
            <span>{String(chapterIndex + 1).padStart(2, "0")}</span>
            <h2>{chapter.title}</h2>
          </header>

          <div class="transcript-turns">
            {chapter.turns.map((turn, turnIndex) => {
              const person = turn.speakerId ? peopleById.get(turn.speakerId) : undefined;
              return (
                <div class:list={["transcript-turn", `is-${turn.kind}`]} data-speaker={turn.speakerId ?? undefined}>
                  <div class="transcript-speaker">
                    {person ? (
                      <a href={`${locale === "en" ? "/en" : ""}/wiki/people/${person.id}`} aria-label={copy.speakerPage(turn.speaker)}>
                        <img
                          src={person.data.photo}
                          width="28"
                          height="28"
                          loading="lazy"
                          decoding="async"
                          alt=""
                        />
                      </a>
                    ) : <span class="transcript-speaker-mark" aria-hidden="true"></span>}
                    <strong>{turn.speaker}</strong>
                    {turn.candidate && (
                      <span class="transcript-candidate" title={copy.candidate} aria-label={copy.candidate}>†</span>
                    )}
                  </div>
                  <div class="transcript-paragraphs">
                    {turn.paragraphs.map((paragraph, paragraphIndex) => {
                      const paragraphId = paragraphAnchorIds[chapterIndex]?.[turnIndex]?.[paragraphIndex];
                      const links = playbackLinks(paragraphId);
                      const legacyTiming = !timeline ? turn.paragraphTimings?.[paragraphIndex] : undefined;
                      return (
                        <p id={paragraphId} class="transcript-quote-paragraph">
                          <TranscriptSegments segments={paragraph} wikiPrefix={locale === "en" ? "/en" : ""} />
                          <a class="transcript-paragraph-link" href={`${episodePath}/transcript#${paragraphId}`} data-paragraph-copy aria-label={copy.paragraphLink} title={copy.paragraphLink}>¶</a>
                          {(links.length > 0 || legacyTiming) && (
                            <span class="transcript-playback">
                              {links.map((link, index) => (
                                <span class="transcript-playback-item">
                                  {(index === 0 || link.time !== links[0]?.time) && <span class="transcript-playback-time">{link.time}</span>}
                                  <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.accessibleLabel} title={link.accessibleLabel}>{link.label}<span aria-hidden="true">↗</span></a>
                                </span>
                              ))}
                              {legacyTiming && <span class="transcript-playback-item">{locale === "en" ? "Video" : "视频"} · {formatTime(legacyTiming.startSeconds)}</span>}
                            </span>
                          )}
                        </p>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </article>
  </div>
  {clipTracks.length > 0 && <TranscriptClipTools episodeNumber={episodeNumber} locale={locale} title={displayTitle} tracks={clipTracks} />}
</main>

<script>
  import "../scripts/transcript-navigation";
  if (document.querySelector("[data-clip-tools]")) import("../scripts/transcript-clips");
</script>
