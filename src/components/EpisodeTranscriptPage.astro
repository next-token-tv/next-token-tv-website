---
import type { CollectionEntry } from "astro:content";
import { getPeopleByIds } from "../data/catalog";
import type { Locale } from "../data/types";
import TranscriptSegments from "./TranscriptSegments.astro";
import TranscriptReaderTools from "./TranscriptReaderTools.astro";
import { getParagraphAnchorIds } from "../data/transcript-paragraph-anchors";

interface Props {
  transcript: CollectionEntry<"transcriptImports">;
  episodeNumber: string;
  locale: Locale;
  isReviewDraft?: boolean;
  displayTitle?: string;
}

const { transcript, episodeNumber, locale, isReviewDraft = false, displayTitle = transcript.data.title } = Astro.props;
const speakerIds = [...new Set(
  transcript.data.chapters.flatMap(({ turns }) => turns.map(({ speakerId }) => speakerId).filter(Boolean)),
)] as string[];
const people = await getPeopleByIds(speakerIds);
const peopleById = new Map(people.map((person) => [person.id, person]));
const [seriesTitle, ...topicParts] = displayTitle.split("｜");
const topicTitle = topicParts.join("｜");
const episodePath = `${locale === "en" ? "/en" : ""}/weekly/${episodeNumber}`;
const paragraphAnchorIds = getParagraphAnchorIds(transcript.data.chapters);
const formatTime = (seconds: number) => {
  const total = Math.floor(seconds);
  return [Math.floor(total / 3600), Math.floor(total / 60) % 60, total % 60].map(n => String(n).padStart(2, '0')).join(':');
};
const copy = locale === "en" ? {
  back: "Back to episode",
  kicker: `Weekly #${episodeNumber} / Transcript`,
  contents: "Contents",
  chapters: "chapters",
  read: "Full transcript",
  markdown: "Markdown format",
  candidate: "speaker attribution pending verification",
  reviewDraft: "Review draft · Not published",
  paragraphLink: "Link to this paragraph",
} : {
  back: "返回本期节目",
  kicker: `Weekly #${episodeNumber} / 阅读文字稿`,
  contents: "本期目录",
  chapters: "个章节",
  read: "完整文字稿",
  markdown: "Markdown 格式",
  candidate: "人物署名仍待核对",
  reviewDraft: "审阅版 · 尚未发布",
  paragraphLink: "引用此段",
};
---

<main id="main" class="transcript-page" data-review-draft={isReviewDraft || undefined}>
  {isReviewDraft && <div class="transcript-review-banner" role="status">{copy.reviewDraft}</div>}
  <header class="transcript-hero shell">
    <a class="transcript-back" href={episodePath}>← {copy.back}</a>
    <div class="transcript-hero-grid">
      <div>
        <p class="section-kicker">{copy.kicker}</p>
        <h1 aria-label={displayTitle}>
          <span>{seriesTitle}</span>
          {topicTitle && <span>{topicTitle}</span>}
        </h1>
      </div>
      <div class="transcript-hero-meta">
        <strong class="transcript-format-row">
          <span>{copy.read}</span>
          {!isReviewDraft && <a class="transcript-format-link" href={`${episodePath}/transcript.md`} type="text/markdown">{copy.markdown} <span aria-hidden="true">↗</span></a>}
        </strong>
        <span>{String(transcript.data.chapterCount).padStart(2, "0")} {copy.chapters}</span>
        <p>{transcript.data.byline}</p>
        {transcript.data.notices.map((notice) => <p class="transcript-notice">{notice}</p>)}
      </div>
    </div>
  </header>

  <div class="transcript-layout shell">
    <aside class="transcript-sidebar">
      <TranscriptReaderTools locale={locale} />
      <details class="transcript-toc" open>
        <summary>{copy.contents} · {transcript.data.chapterCount}</summary>
        <ol>
          {transcript.data.chapters.map((chapter, index) => (
            <li>
              <a href={`#${chapter.id}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {chapter.title}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </aside>

    <article class="transcript-body" aria-label={copy.read}>
      {transcript.data.chapters.map((chapter, chapterIndex) => (
        <section class="transcript-chapter" id={chapter.id}>
          <header>
            <span>{String(chapterIndex + 1).padStart(2, "0")}</span>
            <h2>{chapter.title}</h2>
          </header>

          <div class="transcript-turns">
            {chapter.turns.map((turn, turnIndex) => {
              const person = turn.speakerId ? peopleById.get(turn.speakerId) : undefined;
              return (
                <div class:list={["transcript-turn", `is-${turn.kind}`]} data-speaker={turn.speakerId ?? undefined}>
                  <div class="transcript-speaker">
                    {person ? (
                      <a href={`/wiki/people/${person.id}`} aria-label={`查看${turn.speaker}的个人页面`}>
                        <img
                          src={person.data.photo}
                          width="28"
                          height="28"
                          loading="lazy"
                          decoding="async"
                          alt=""
                        />
                      </a>
                    ) : <span class="transcript-speaker-mark" aria-hidden="true"></span>}
                    <strong>{turn.speaker}</strong>
                    {turn.candidate && (
                      <span class="transcript-candidate" title={copy.candidate} aria-label={copy.candidate}>†</span>
                    )}
                  </div>
                  <div class="transcript-paragraphs">
                    {turn.paragraphs.map((paragraph, paragraphIndex) => {
                      const paragraphId = paragraphAnchorIds[chapterIndex]?.[turnIndex]?.[paragraphIndex];
                      const timing = turn.paragraphTimings?.[paragraphIndex];
                      return (
                        <p id={paragraphId} class="transcript-quote-paragraph">
                          <TranscriptSegments segments={paragraph} />
                          {timing && <span class="transcript-paragraph-time" title={locale === 'en' ? 'Video subtitle cue range; not word-level timing' : '视频字幕对应范围，非逐字对齐时间'}>{locale === 'en' ? 'Video' : '视频'} · {formatTime(timing.startSeconds)}–{formatTime(timing.endSeconds)}</span>}
                          {!isReviewDraft && <a class="transcript-paragraph-link" href={`${episodePath}/transcript#${paragraphId}`} data-paragraph-copy aria-label={copy.paragraphLink} title={copy.paragraphLink}>¶</a>}
                        </p>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </article>
  </div>
</main>

<script>
  const sidebar = document.querySelector<HTMLElement>('.transcript-sidebar');
  const toc = sidebar?.querySelector<HTMLDetailsElement>('.transcript-toc');
  const list = toc?.querySelector<HTMLOListElement>('ol');
  const chapters = [...document.querySelectorAll<HTMLElement>('.transcript-chapter')];
  const links = [...(toc?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? [])];
  if (sidebar && toc && list && chapters.length) {
    let active = -1;
    let frame = 0;
    const reveal = () => {
      const link = links[active];
      if (!link || !toc.open) return;
      const bounds = list.getBoundingClientRect();
      const item = link.getBoundingClientRect();
      if (item.top < bounds.top || item.bottom > bounds.bottom) {
        // Only move the directory's own scroll container, never the document.
        list.scrollTop += item.top - bounds.top - (bounds.height - item.height) / 2;
      }
    };
    const update = () => {
      frame = 0;
      const readingLine = parseFloat(getComputedStyle(chapters[0]!).scrollMarginTop) + 1;
      let index = 0;
      for (let i = 0; i < chapters.length; i++) {
        if (chapters[i]!.getBoundingClientRect().top <= readingLine) index = i;
        else break;
      }
      if (index !== active) {
        links[active]?.removeAttribute('aria-current');
        active = index;
        links[active]?.setAttribute('aria-current', 'location');
        reveal();
      }
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    const resize = () => {
      // Reserve room for search, legend and the directory heading on short screens.
      if (getComputedStyle(sidebar).position === 'sticky') {
        const top = parseFloat(getComputedStyle(sidebar).top);
        const controls = list.getBoundingClientRect().top - sidebar.getBoundingClientRect().top;
        list.style.maxHeight = `${Math.max(80, innerHeight - top - controls - 16) / parseFloat(getComputedStyle(document.documentElement).fontSize)}rem`;
      } else list.style.removeProperty('max-height');
      schedule();
      reveal();
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', resize);
    addEventListener('hashchange', schedule);
    toc.addEventListener('toggle', resize);
    new ResizeObserver(resize).observe(sidebar.querySelector('.transcript-search') ?? sidebar);
    document.fonts.ready.then(resize);
    resize();
  }
</script>
