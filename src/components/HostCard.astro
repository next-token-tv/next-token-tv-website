---
import PersonCard from "./PersonCard.astro";
import type { Host } from "../data/site";

interface Props {
  host: Host;
  socialPlatforms: string[];
  compactPlatforms: string[];
  socialRowCount: number;
}

const { host, socialPlatforms, compactPlatforms, socialRowCount } = Astro.props;
const rows = socialPlatforms.map(platform => ({ platform, social: host.socials.find(social => social.platform === platform) }))
  .filter(({ platform, social }) => !compactPlatforms.includes(platform) || social);
while (rows.length < socialRowCount) rows.push({ platform: "", social: undefined });
---

<PersonCard {...host} class="host-card" copyClass="host-info">
    <ul class="host-socials host-socials-aligned" aria-label={host.socialsLabel}>
      {rows.map(({ platform, social }) => (
        <li data-platform={platform || undefined} aria-hidden={!social ? "true" : undefined}>
          {social && <>
          {social.href ? (
            <a href={social.href} target="_blank" rel="noopener noreferrer">
              <span class="social-platform">{social.platform}</span>
              <span class="social-handle">{social.handle}</span>
              <span class="social-arrow" aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="social-account">
              <span class="social-platform">{social.platform}</span>
              <span class="social-handle">{social.handle}</span>
              <span class="social-note">{social.note}</span>
            </span>
          )}
          </>}
        </li>
      ))}
    </ul>
</PersonCard>
