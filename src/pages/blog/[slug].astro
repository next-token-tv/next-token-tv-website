---
import BlogArticlePage from "../../components/BlogArticlePage.astro";
import { getBlogPosts } from "../../data/blog";
export async function getStaticPaths() {
  return (await getBlogPosts("zh-Hans")).map(article => ({ params: { slug: article.id }, props: { article } }));
}
---
<BlogArticlePage locale="zh-Hans" article={Astro.props.article} />
