---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getSiteContent } from "../../../data/site";
import { getEpisodesForShow, getPublishedTranscriptEpisodes } from "../../../data/catalog";
import { getBlogPosts } from "../../../data/blog";

export async function getStaticPaths() {
  return (await getEpisodesForShow("next-token-weekly"))
    .filter(episode => episode.data.status === "published")
    .map(episode => ({ params: { number: episode.data.number }, props: { episode } }));
}
const { episode } = Astro.props;
const content = await getSiteContent("zh-Hans");
const posts = (await getBlogPosts()).filter(post => post.data.episodes.includes(episode.id));
const number = episode.data.number;
const hasTranscript = (await getPublishedTranscriptEpisodes("zh-Hans")).some(entry => entry.id === episode.id);
---
<BaseLayout content={content} pageTitle={`第 ${number} 期相关博客`} description={`从 Next Token Weekly 第 ${number} 期延伸的主题文章。`} canonicalPath={`/blog/episodes/${number}`} alternatePath={`/en/blog/episodes/${number}`}>
  <main id="main" class="episode-blog shell">
    <header>
      <a href="/blog/episodes">← 按期浏览</a>
      <p class="section-kicker">博客 / WEEKLY #{number}</p>
      <h1>第 {number} 期相关博客</h1>
      <p class="episode-title">{episode.data.title["zh-Hans"]}</p>
      <nav aria-label="本期内容"><a href={`/weekly/${number}`}>本期节目 →</a>{hasTranscript && <a href={`/weekly/${number}/transcript`}>完整文字稿 →</a>}</nav>
    </header>
    <section aria-label="本期相关博客" class="posts">
      {posts.length ? posts.map(post => <article>
        <div class="meta"><time datetime={post.data.publishedAt ?? post.data.updatedAt}>{post.data.publishedAt ?? post.data.updatedAt}</time>{post.data.status === "draft" && <span>审阅稿</span>}</div>
        <div><h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p></div>
      </article>) : <p>本期相关博客正在准备中。</p>}
    </section>
  </main>
</BaseLayout>
<style>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
.episode-blog { padding-block: 3rem 5rem; min-height: 65vh; }
  header { padding-bottom: 3rem; }
  .section-kicker { margin-top: 2rem; }
  h1 { font-size: clamp(2rem, 4vw, 3.75rem); margin-block: 1.5rem; }
  .episode-title, article p, .meta { color: var(--muted); }
  nav, .meta { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  nav { margin-top: 1.5rem; }
  article { display: grid; grid-template-columns: minmax(0, 12rem) minmax(0, 46rem); gap: 3rem; padding-block: 2rem; border-top: .0625rem solid var(--line); }
  .meta { align-content: start; font-size: .85rem; }
  h2 { font-size: 1.75rem; margin: 0 0 1rem; }
  article p { line-height: 1.8; }
  a:hover { color: var(--signal); }
  @media (max-width: 47.999rem) { article { grid-template-columns: minmax(0, 1fr); gap: 1rem; } }
}
</style>
