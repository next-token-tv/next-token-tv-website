---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteContent } from "../../data/site";
import { getBlogPosts } from "../../data/blog";
import { getEpisodesForShow } from "../../data/catalog";
const content = await getSiteContent("zh-Hans");
const posts = await getBlogPosts();
const episodes = (await getEpisodesForShow("next-token-weekly")).filter(episode => posts.some(post => post.data.episodes.includes(episode.id))).reverse();
---
<BaseLayout content={content} pageTitle="博客｜Next Token 词元之外" description="从 Next Token 对谈出发，深入阅读 AI 产品、技术与真实使用体验。" canonicalPath="/blog" alternatePath="/en/blog">
  <main id="main" class="blog-page shell">
    <header class="blog-intro">
      <p class="section-kicker">NEXT TOKEN / 博客</p>
      <h1>从对谈出发，<br />把一个问题聊透。</h1>
      <p>AI 产品、技术与真实使用体验。值得展开的话题，值得留下的细节。</p>
      <a class="blog-read" href="/blog/episodes">按期浏览博客 <span aria-hidden="true">→</span></a>
      <a class="blog-read blog-feed" href="/blog/rss.xml" type="application/rss+xml">RSS 订阅 <span aria-hidden="true">↗</span></a>
    </header>
    <form class="blog-filters" hidden role="search" aria-label="筛选博客">
      <div><label for="blog-query">搜索主题</label><input id="blog-query" type="search" name="q" placeholder="标题或摘要中的关键词" /></div>
      <div><label for="blog-episode">节目期数</label><select id="blog-episode" name="episode"><option value="">全部期数</option>{episodes.map(episode => <option value={episode.data.number}>第 {episode.data.number} 期</option>)}</select></div>
      <button type="reset">清除筛选</button>
      <p class="filter-count" role="status" aria-live="polite">{posts.length} 篇文章</p>
    </form>
    <p class="blog-no-results" hidden>没有找到相关文章，试试其他关键词或期数。</p>
    <section aria-label="博客文章" class="blog-list">
      {posts.length ? posts.map(post => <article class="blog-row" data-search={`${post.data.title} ${post.data.description}`} data-episodes={post.data.episodes.join(" ")}>
        <div class="blog-meta"><time datetime={post.data.publishedAt ?? post.data.updatedAt}>{post.data.publishedAt ?? post.data.updatedAt}</time>{post.data.status === "draft" && <span>审阅稿</span>}</div>
        <div><h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="blog-read" href={`/blog/${post.id}`}>阅读全文 <span aria-hidden="true">→</span></a></div>
      </article>) : <p class="blog-empty">文章正在准备中。先从 <a href="/weekly">Weekly 对谈</a> 开始阅读。</p>}
    </section>
  </main>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>(".blog-filters");
  const query = document.querySelector<HTMLInputElement>("#blog-query");
  const episode = document.querySelector<HTMLSelectElement>("#blog-episode");
  const rows = [...document.querySelectorAll<HTMLElement>(".blog-row")];
  if (form && query && episode) {
    const normalize = (value: string) => value.normalize("NFKC").toLocaleLowerCase();
    const apply = (updateUrl: boolean) => {
      const terms = normalize(query.value).trim().split(/\s+/u).filter(Boolean);
      let count = 0;
      for (const row of rows) {
        const matches = terms.every(term => normalize(row.dataset.search ?? "").includes(term)) &&
          (!episode.value || (row.dataset.episodes ?? "").split(" ").includes(`next-token-weekly--${episode.value}`));
        row.hidden = !matches;
        if (matches) count++;
      }
      form.querySelector<HTMLElement>(".filter-count")!.textContent = `${count} 篇文章`;
      document.querySelector<HTMLElement>(".blog-no-results")!.hidden = count > 0;
      if (updateUrl) {
        const url = new URL(location.href);
        for (const [key, value] of [["q", query.value.trim()], ["episode", episode.value]] as const) {
          if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
        }
        history.replaceState(null, "", url);
      }
    };
    const restore = () => {
      const params = new URLSearchParams(location.search);
      query.value = params.get("q") ?? "";
      episode.value = params.get("episode") ?? "";
      apply(false);
    };
    form.hidden = false;
    restore();
    form.addEventListener("submit", event => { event.preventDefault(); apply(true); });
    query.addEventListener("input", () => apply(true));
    episode.addEventListener("change", () => apply(true));
    form.addEventListener("reset", () => { query.value = ""; episode.value = ""; apply(true); });
    window.addEventListener("popstate", restore);
  }
</script>
<style>
@layer reset, tokens, base, layouts, components, utilities, overrides;
@layer components {
.blog-filters { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; gap: 1rem 1.5rem; align-items: end; margin-bottom: 2rem; }
  .blog-filters label { display: block; margin-bottom: .5rem; font-size: .85rem; font-weight: 700; }
  .blog-filters input, .blog-filters button { min-height: 2.75rem; padding: .65rem .85rem; border: .0625rem solid var(--line); background: transparent; color: var(--ink); font: inherit; }
  .blog-filters input, .blog-filters select { width: 100%; min-width: 0; }
  .blog-filters button { cursor: pointer; }
  .filter-count { grid-column: 1 / -1; color: var(--muted); font-size: .85rem; }
  .blog-no-results { padding-block: 2rem; color: var(--muted); }
  .blog-page [hidden] { display: none; }
  @media (max-width: 47.999rem) { .blog-filters { grid-template-columns: minmax(0, 1fr); } }

  .blog-page { padding-block: 3rem 5rem; min-height: 65vh; }
  .blog-intro { padding-bottom: 3rem; }
  h1 { font-size: 2.75rem; margin-block: 1.5rem; }
  .blog-intro > p:not(.section-kicker) { font-size: 1.125rem; color: var(--muted); max-width: 38rem; }
  .blog-row { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 46rem); gap: 4rem; padding-block: 2.5rem; border-top: .0625rem solid var(--ink); }
  .blog-meta { display: flex; flex-direction: column; gap: .75rem; font-size: .85rem; color: var(--muted); }
  h2 { text-wrap: balance; font-size: 1.75rem; margin: 0 0 1rem; }
  .blog-row p { color: var(--muted); line-height: 1.8; }
  .blog-read { display: inline-flex; gap: 2rem; margin-top: 1.5rem; font-weight: 700; }
  a:hover { color: var(--signal); }
  .blog-feed { margin-inline-start: 2rem; }
  .blog-empty { border-top: .0625rem solid var(--line); padding-block: 2rem; }
  .blog-empty a { text-decoration: underline; }
  @media (min-width: 48rem) { h1 { font-size: 3.75rem; } }
  @media (max-width: 47.999rem) { .blog-row { grid-template-columns: minmax(0, 1fr); gap: 1rem; } .blog-meta { flex-direction: row; align-items: center; flex-wrap: wrap; } }
}
</style>
