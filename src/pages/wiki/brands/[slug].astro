---
import EntityDetailPage from "../../../components/EntityDetailPage.astro";
import { getBrandDirectory, getBrandProfile } from "../../../data/catalog";
import { getSiteContent } from "../../../data/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const brands = await getBrandDirectory("zh-Hans");
  return brands.map(({ brand }) => ({ params: { slug: brand.id }, props: { brandId: brand.id } }));
}

interface Props { brandId: string; }
const { brandId } = Astro.props;
const [content, profile] = await Promise.all([getSiteContent("zh-Hans"), getBrandProfile(brandId)]);
---

<BaseLayout
  content={content}
  pageTitle={`${profile.brand.data.name["zh-Hans"]}｜品牌资料库｜Next Token`}
  description={profile.brand.data.summary["zh-Hans"]}
  canonicalPath={`/wiki/brands/${brandId}/`}
  alternatePath={`/en/wiki/brands/${brandId}/`}
>
  <EntityDetailPage entityType="brand" entityId={brandId} locale="zh-Hans" />
</BaseLayout>
