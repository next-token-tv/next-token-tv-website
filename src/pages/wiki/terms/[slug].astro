---
import { getTerms } from "../../../data/terms";
import { getSiteContent } from "../../../data/site";
import TermDetailPage from "../../../components/TermDetailPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
export async function getStaticPaths() {
  return (await getTerms()).map(term => ({ params: { slug: term.id }, props: { term } }));
}
const { term } = Astro.props;
const content = await getSiteContent("zh-Hans");
---
<BaseLayout content={content} pageTitle={`${term.data.name["zh-Hans"]}｜术语｜Next Token`} description={term.data.summary["zh-Hans"]} canonicalPath={`/wiki/terms/${term.id}`} alternatePath={`/en/wiki/terms/${term.id}`}>
  <TermDetailPage term={term} locale="zh-Hans" />
</BaseLayout>
