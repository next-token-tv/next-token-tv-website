---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getSiteContent } from "../../../../data/site";
import { getEpisodesForShow, getPublishedTranscriptEpisodes } from "../../../../data/catalog";
import { getBlogPosts } from "../../../../data/blog";

export async function getStaticPaths() {
  return (await getEpisodesForShow("next-token-weekly"))
    .filter(episode => episode.data.status === "published")
    .map(episode => ({ params: { number: episode.data.number }, props: { episode } }));
}
const { episode } = Astro.props;
const content = await getSiteContent("en");
const posts = (await getBlogPosts("en")).filter(post => post.data.episodes.includes(episode.id));
const number = episode.data.number;
const hasTranscript = (await getPublishedTranscriptEpisodes("en")).some(entry => entry.id === episode.id);
---
<BaseLayout content={content} pageTitle={`Blog for episode ${number}`} description={`Topic articles expanding on Next Token Weekly episode ${number}.`} canonicalPath={`/en/blog/episodes/${number}`} alternatePath={`/blog/episodes/${number}`}>
  <main id="main" class="episode-blog shell">
    <header>
      <a href="/en/blog/episodes">← Browse by episode</a>
      <p class="section-kicker">Blog / WEEKLY #{number}</p>
      <h1>Blog for episode {number}</h1>
      <p class="episode-title">{episode.data.title["en"]}</p>
      <nav aria-label="In this episode"><a href={`/en/weekly/${number}`}>This episode →</a>{hasTranscript && <a href={`/en/weekly/${number}/transcript`}>Full transcript →</a>}</nav>
    </header>
    <section aria-label="Related articles" class="posts">
      {posts.length ? posts.map(post => <article>
        <div class="meta"><time datetime={post.data.publishedAt ?? post.data.updatedAt}>{post.data.publishedAt ?? post.data.updatedAt}</time>{post.data.status === "draft" && <span>Under review</span>}</div>
        <div><h2><a href={`/en/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p></div>
      </article>) : <p>Related articles for this episode are in preparation.</p>}
    </section>
  </main>
</BaseLayout>
<style>
  .episode-blog { padding-block: 3rem 5rem; min-height: 65vh; }
  header { padding-bottom: 3rem; }
  .section-kicker { margin-top: 2rem; }
  h1 { font-size: clamp(2rem, 4vw, 3.75rem); margin-block: 1.5rem; }
  .episode-title, article p, .meta { color: var(--muted); }
  nav, .meta { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  nav { margin-top: 1.5rem; }
  article { display: grid; grid-template-columns: minmax(0, 12rem) minmax(0, 46rem); gap: 3rem; padding-block: 2rem; border-top: .0625rem solid var(--line); }
  .meta { align-content: start; font-size: .85rem; }
  h2 { font-size: 1.75rem; margin: 0 0 1rem; }
  article p { line-height: 1.8; }
  a:hover { color: var(--signal); }
  @media (max-width: 47.999rem) { article { grid-template-columns: minmax(0, 1fr); gap: 1rem; } }
</style>
