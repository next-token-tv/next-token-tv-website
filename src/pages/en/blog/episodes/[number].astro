---
import Page from "../../../../components/BlogEpisodePage.astro";
import { getEpisodesForShow } from "../../../../data/catalog";
export async function getStaticPaths() {
  return (await getEpisodesForShow("next-token-weekly"))
    .filter(episode => episode.data.status === "published")
    .map(episode => ({ params: { number: episode.data.number }, props: { episode } }));
}
---
<Page locale="en" episode={Astro.props.episode} />
