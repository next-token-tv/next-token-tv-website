---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PartnerDetailPage from "../../../components/PartnerDetailPage.astro";
import { partners, partnerPath, type Partner } from "../../../data/partners";
import { siteContent } from "../../../data/site";

export function getStaticPaths() {
  return partners.map((partner) => ({ params: { slug: partner.slug }, props: { partner } }));
}

interface Props {
  partner: Partner;
}

const { partner } = Astro.props;
const content = siteContent.en;
---

<BaseLayout
  content={content}
  pageTitle={`${partner.englishName} | Next Token Venue Partner`}
  description={partner.summary.en}
  canonicalPath={partnerPath(partner, "en")}
  alternatePath={partnerPath(partner, "zh-Hans")}
>
  <PartnerDetailPage partner={partner} locale="en" />
</BaseLayout>
