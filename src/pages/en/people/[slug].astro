---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HostProfilePage from "../../../components/HostProfilePage.astro";
import { getHostProfileIds, getPeopleByIds } from "../../../data/catalog";
import { getSiteContent } from "../../../data/site";
export async function getStaticPaths() {
  return (await getHostProfileIds()).map(slug => ({ params: { slug } }));
}
const personId = Astro.params.slug!;
const [person] = await getPeopleByIds([personId]);
if (!person) throw new Error(`Unknown profile: ${personId}`);
const content = await getSiteContent("en");
---
<BaseLayout content={content} pageTitle={`${person.data.name.en} | Next Token Co-host`} description={person.data.bio.en} canonicalPath={`/en/people/${personId}/`} alternatePath={`/people/${personId}/`}>
  <HostProfilePage personId={personId} locale="en" />
</BaseLayout>
