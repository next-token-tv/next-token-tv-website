---
import "../styles/global.css";
import type { SiteContent } from "../data/site";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  content: SiteContent;
  autoRedirect?: boolean;
  pageTitle?: string;
  description?: string;
  canonicalPath?: string;
  alternatePath?: string;
  noIndex?: boolean;
}

const {
  content,
  autoRedirect = false,
  pageTitle = content.title,
  description = content.description,
  canonicalPath = content.path,
  alternatePath = content.locale === "en" ? "/" : "/en/",
  noIndex = false,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const alternate = new URL(alternatePath, Astro.site);
---

<!doctype html>
<html lang={content.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f1eee5" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={content.locale} href={canonical} />
    <link rel="alternate" hreflang={content.locale === "en" ? "zh-Hans" : "en"} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={content.locale === "zh-Hans" ? canonical : alternate} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <title>{pageTitle}</title>
    {autoRedirect && (
      <script is:inline>
        (() => {
          if (window.location.pathname !== "/") return;

          const storageKey = "next-token-language";
          let selectedLanguage = null;

          try {
            selectedLanguage = window.localStorage.getItem(storageKey);
          } catch {}

          const browserLanguage = navigator.languages?.[0] || navigator.language || "";
          const prefersChinese = /^zh(?:-|$)/i.test(browserLanguage);
          const targetLanguage = selectedLanguage || (browserLanguage && !prefersChinese ? "en" : "zh-Hans");

          if (targetLanguage === "en") {
            window.location.replace(`/en/${window.location.search}${window.location.hash}`);
          }
        })();
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{content.skipLink}</a>
    <SiteHeader content={content} currentPath={canonicalPath} alternatePath={alternatePath} />
    <slot />
    <SiteFooter locale={content.locale} />
    <script>
      document.querySelectorAll<HTMLAnchorElement>("[data-language]").forEach((link) => {
        link.addEventListener("click", () => {
          try {
            window.localStorage.setItem("next-token-language", link.dataset.language ?? "zh-Hans");
          } catch {}
        });
      });
    </script>
  </body>
</html>
