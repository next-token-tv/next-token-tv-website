{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "next-token-tv",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "nexttoken.tv",
      "custom_domain": true
    }
  ]
}
